NODE_ENV=development
WEB_PORT=3000
API_HOST=0.0.0.0
API_PORT=4000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000
API_RATE_LIMIT_TTL_MS=60000
API_RATE_LIMIT_MAX=100

POSTGRES_DB=event_platform
POSTGRES_PORT=55432
POSTGRES_USER=event_platform
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://event_platform:change-me@localhost:55432/event_platform?schema=public

API_INTERNAL_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:4000
# The timezone event times are entered and shown in. Storage stays UTC.
NEXT_PUBLIC_APP_TIMEZONE=Africa/Addis_Ababa

# Authentication. The two secrets are required and must be at least 32 characters;
# replace them with random values before use.
AUTH_ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
AUTH_REFRESH_TOKEN_SECRET=replace-with-at-least-32-random-characters
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=30d
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_MAX_FAILED_ATTEMPTS=10
AUTH_LOCKOUT_DURATION_MS=900000
AUTH_LOGIN_RATE_LIMIT_MAX=20
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=300000

# Real-time (Socket.IO /realtime) per-connection command rate limit.
REALTIME_COMMAND_RATE_LIMIT_MAX=30
REALTIME_COMMAND_RATE_LIMIT_WINDOW_MS=10000

# Private S3-compatible storage. These defaults are for the local MinIO
# service only; production values must be supplied outside the repository.
FILE_STORAGE_ENDPOINT=http://localhost:9000
# Browser-reachable address used to sign upload/download grants when different.
FILE_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
FILE_STORAGE_REGION=us-east-1
FILE_STORAGE_BUCKET=event-platform-files
FILE_STORAGE_ACCESS_KEY=minioadmin
FILE_STORAGE_SECRET_KEY=minioadmin
FILE_STORAGE_FORCE_PATH_STYLE=true
# `test` is a development-only scanner. Set `unavailable` to exercise the
# safe failure path; a production scanner adapter is required before launch.
FILE_SCANNER_MODE=test

# Local Super Admin seeded by `pnpm db:seed:admin` (optional; these are the
# defaults). Development only - there is no self-serve first-admin flow yet.
DEV_ADMIN_EMAIL=admin@dev.local
DEV_ADMIN_PASSWORD=dev-Passw0rd!

# Optional self-hosted Jitsi Meet video conferencing (API-only). Off until a
# Jitsi domain is configured. See docs/development/jitsi-integration.md and
# the separate docker/jitsi/ + docker/reverse-proxy/ deployment (not part of
# this compose file). Never use NEXT_PUBLIC_ keys - the frontend learns the
# domain from the live jitsi-session API response, not a build-time var.
JITSI_ENABLED=false
JITSI_DOMAIN=
# Reserved for an optional future JWT/moderator scheme; leave disabled until
# a self-hosted Jitsi server actually exists to test against.
JITSI_JWT_ENABLED=false
JITSI_APP_ID=
JITSI_APP_SECRET=

# AfroMessage SMS. Disabled by default. Enabling it requires the API key and a
# callback token of at least 32 characters. The sender ID is optional (verified
# accounts only); without it messages go out from the identifier. Never commit real values.
AFROMESSAGE_ENABLED=false
AFROMESSAGE_API_KEY=
AFROMESSAGE_SENDER_ID=
AFROMESSAGE_IDENTIFIER_ID=
AFROMESSAGE_BASE_URL=https://api.afromessage.com/api
AFROMESSAGE_CALLBACK_TOKEN=
AFROMESSAGE_TIMEOUT_MS=10000
# Minutes before a meeting when participants receive a reminder SMS (5-1440).
MEETING_REMINDER_MINUTES=30

# Dedicated database for integration tests. Must end in _test; never the development database.
INTEGRATION_DATABASE_URL=postgresql://event_platform:replace-me@localhost:55432/event_platform_test?schema=public
