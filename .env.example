NODE_ENV=development
WEB_PORT=3000
API_HOST=0.0.0.0
API_PORT=4000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000
API_RATE_LIMIT_TTL_MS=60000
API_RATE_LIMIT_MAX=100

POSTGRES_DB=event_platform
POSTGRES_PORT=55432
POSTGRES_USER=event_platform
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://event_platform:change-me@localhost:55432/event_platform?schema=public

API_INTERNAL_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:4000

# Authentication. The two secrets are required and must be at least 32 characters;
# replace them with random values before use.
AUTH_ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
AUTH_REFRESH_TOKEN_SECRET=replace-with-at-least-32-random-characters
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=30d
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_MAX_FAILED_ATTEMPTS=10
AUTH_LOCKOUT_DURATION_MS=900000
AUTH_LOGIN_RATE_LIMIT_MAX=20
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=300000

# Real-time (Socket.IO /realtime) per-connection command rate limit.
REALTIME_COMMAND_RATE_LIMIT_MAX=30
REALTIME_COMMAND_RATE_LIMIT_WINDOW_MS=10000

# Private S3-compatible storage. These defaults are for the local MinIO
# service only; production values must be supplied outside the repository.
FILE_STORAGE_ENDPOINT=http://localhost:9000
FILE_STORAGE_REGION=us-east-1
FILE_STORAGE_BUCKET=event-platform-files
FILE_STORAGE_ACCESS_KEY=minioadmin
FILE_STORAGE_SECRET_KEY=minioadmin
FILE_STORAGE_FORCE_PATH_STYLE=true
# `test` is a development-only scanner. Set `unavailable` to exercise the
# safe failure path; a production scanner adapter is required before launch.
FILE_SCANNER_MODE=test

# Local Super Admin seeded by `pnpm db:seed:admin` (optional; these are the
# defaults). Development only - there is no self-serve first-admin flow yet.
DEV_ADMIN_EMAIL=admin@dev.local
DEV_ADMIN_PASSWORD=dev-Passw0rd!
