NODE_ENV=development
WEB_PORT=3000
API_HOST=0.0.0.0
API_PORT=4000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000
API_RATE_LIMIT_TTL_MS=60000
API_RATE_LIMIT_MAX=100

POSTGRES_DB=event_platform
POSTGRES_PORT=55432
POSTGRES_USER=event_platform
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://event_platform:change-me@localhost:55432/event_platform?schema=public

API_INTERNAL_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:4000

# Reserved for the authentication implementation. Replace these values before use.
AUTH_ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
AUTH_REFRESH_TOKEN_SECRET=replace-with-at-least-32-random-characters
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=30d
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
