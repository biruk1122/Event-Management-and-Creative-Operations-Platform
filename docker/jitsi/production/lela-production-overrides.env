# Append this block to docker-jitsi-meet's own generated .env (see
# README.md) - do not replace their file, just add these lines at the
# bottom, after filling in the placeholders.

# --- Lela production deployment overrides (not part of upstream env.example) ---

CONFIG=./.jitsi-meet-cfg

# A real public domain with its own DNS record, distinct from Lela's own
# application domain.
PUBLIC_URL=https://meet.example.com

# Run BEHIND the shared reverse proxy (docker/reverse-proxy/) rather than
# terminating TLS itself - that proxy is the only thing that binds host
# 80/443 on the VPS, so Jitsi's own Let's Encrypt automation must stay off.
DISABLE_HTTPS=1
HTTP_PORT=8000
HTTPS_PORT=8443

# The VPS's real public IP (not a Docker-internal address) - JVB advertises
# this to clients for media.
JVB_ADVERTISE_IPS=203.0.113.10

# Pin a specific stable tag (never the "unstable" default) - check
# https://github.com/jitsi/docker-jitsi-meet/releases for the current one;
# this was current as of this integration's implementation.
JITSI_IMAGE_VERSION=stable-11248
