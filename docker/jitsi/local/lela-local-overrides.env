# Append this block to docker-jitsi-meet's own generated .env (see
# README.md step 3) - do not replace their file, just add these lines at
# the bottom. Comment out their original CONFIG= line above when you do,
# so there's only one effective value.

# --- Lela local development overrides (not part of upstream env.example) ---

# A path relative to this directory, not the user's home - avoids Windows/
# Git-Bash/WSL2 ambiguity around `~` expansion in Compose volume mounts.
CONFIG=./.jitsi-meet-cfg

HTTP_PORT=8000
HTTPS_PORT=8443

# Deliberately do NOT set DISABLE_HTTPS or ENABLE_LETSENCRYPT. The official
# web image's own entrypoint then auto-generates a self-signed certificate
# (CN=*, works for any hostname) and persists it - this is its documented
# local/test behavior, not a workaround. HTTPS is required here: the
# official Jitsi IFrame API (external_api.js) unconditionally builds the
# embed URL as `https://${domain}/...` with no option to use plain HTTP, so
# "localhost counts as a secure context over HTTP" does not actually help
# for the *embedded iframe* (it would for a getUserMedia call made directly
# by Lela's own origin, but the Jitsi UI itself runs in its own iframe at
# its own origin, which the IFrame API controls, not us).
PUBLIC_URL=https://localhost:8443

# Same-machine testing only (two browser tabs/profiles, or two user
# accounts) - both "participants" reach JVB over loopback. Testing from a
# genuinely separate device needs this changed to that device's real LAN-
# reachable IP, plus one of the workarounds in README.md's "second device"
# section, since that IP is not a browser-trusted secure context by default.
JVB_ADVERTISE_IPS=127.0.0.1

# Pin a specific stable tag (never the "unstable" default) - check
# https://github.com/jitsi/docker-jitsi-meet/releases for the current one;
# this was current as of this integration's implementation.
JITSI_IMAGE_VERSION=stable-11248
