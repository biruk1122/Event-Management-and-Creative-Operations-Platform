# Shared reverse-proxy config. Copy to docker/reverse-proxy/.env and fill
# in real values - never commit the filled-in file.

# Lela's own application domain - distinct from JITSI_DOMAIN below.
LELA_DOMAIN=lela.example.com

# The self-hosted Jitsi deployment's domain (must match the PUBLIC_URL
# host in docker/jitsi/production/lela-production-overrides.env exactly).
JITSI_DOMAIN=meet.example.com

# Contact email Let's Encrypt uses for certificate expiry notices.
ACME_EMAIL=admin@example.com

# The external Docker network this proxy and docker/jitsi/production/
# both join - create it once with `docker network create lela-edge`
# before starting either stack.
EDGE_NETWORK_NAME=lela-edge
