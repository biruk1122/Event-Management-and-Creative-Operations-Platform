{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "API_HOST",
    "API_INTERNAL_URL",
    "API_PORT",
    "API_RATE_LIMIT_MAX",
    "API_RATE_LIMIT_TTL_MS",
    "AUTH_ACCESS_TOKEN_SECRET",
    "AUTH_ACCESS_TOKEN_TTL",
    "AUTH_COOKIE_SAME_SITE",
    "AUTH_COOKIE_SECURE",
    "AUTH_REFRESH_TOKEN_SECRET",
    "AUTH_REFRESH_TOKEN_TTL",
    "CORS_ORIGINS",
    "DATABASE_URL",
    "LOG_LEVEL",
    "NODE_ENV",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_WS_URL",
    "POSTGRES_DB",
    "POSTGRES_PASSWORD",
    "POSTGRES_PORT",
    "POSTGRES_USER",
    "WEB_PORT"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    }
  }
}
