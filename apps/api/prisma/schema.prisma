generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// Account and profile record. IAM created it auth-first (`email`, `status`);
/// USR-01 added the SRS profile fields and the deactivation timestamp as a
/// non-destructive extension. All profile fields are nullable: existing rows
/// predate them and USR-02's create-user API is where a name becomes
/// mandatory. Role assignment is `UserRoleAssignment`, owned by RBAC-02 so
/// policy evaluation works before this issue; team membership is the
/// `TeamMembership` join table added by TEAM-01. DEP-01 adds `department_id` (the
/// optional employee -> department assignment) and the inverse
/// `managedDepartments` for the Department Manager slot. `email` uniqueness is
/// case-sensitive at the database; IAM-02 normalises addresses to lower case
/// on every write and lookup.
enum UserAccountStatus {
  ACTIVE
  INACTIVE

  @@map("user_account_status")
}

/// Why a refresh session stopped being valid. Set together with `revoked_at`.
enum SessionRevocationReason {
  LOGOUT
  ROTATED
  REUSE_DETECTED
  EXPIRED
  ADMIN_REVOKED
  PASSWORD_CHANGED

  @@map("session_revocation_reason")
}

/// Minimal durable audit vocabulary required at security- and
/// approval-sensitive action boundaries. The authorized query/export surface,
/// retention, and storage-level tamper controls remain owned by REL-02.
enum AuditActorKind {
  USER
  SYSTEM
  ANONYMOUS

  @@map("audit_actor_kind")
}

enum AuditOutcome {
  SUCCEEDED
  DENIED
  FAILED

  @@map("audit_outcome")
}

/// Append-only evidence. No application update/delete interface is exposed.
/// Actor identifiers intentionally have no foreign key so account lifecycle
/// cannot erase historical attribution.
model AuditRecord {
  id               String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  occurredAt       DateTime       @default(now()) @map("occurred_at") @db.Timestamptz(6)
  actorKind        AuditActorKind @map("actor_kind")
  actorUserId      String?        @map("actor_user_id") @db.Uuid
  requestId        String?        @map("request_id")
  correlationId    String?        @map("correlation_id")
  action           String
  resourceType     String         @map("resource_type")
  resourceId       String?        @map("resource_id") @db.Uuid
  workspaceContext String?        @map("workspace_context") @db.Uuid
  outcome          AuditOutcome
  metadata         Json           @default("{}") @db.JsonB

  @@index([occurredAt, id])
  @@index([action, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([resourceType, resourceId, occurredAt])
  @@index([workspaceContext, occurredAt])
  @@map("audit_records")
}

model User {
  id            String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email         String            @unique
  firstName     String?           @map("first_name")
  lastName      String?           @map("last_name")
  phone         String?
  profileImage  String?           @map("profile_image")
  status        UserAccountStatus @default(ACTIVE)
  /// Set when `status` becomes INACTIVE and cleared on reactivation; a CHECK
  /// keeps it exactly in step with `status`.
  deactivatedAt DateTime?         @map("deactivated_at") @db.Timestamptz(6)
  /// The one department this user is an employee of, or NULL when unassigned.
  /// Cleared, not cascaded, if that department row is ever removed (DEP-01);
  /// deactivation keeps the assignment.
  departmentId  String?           @map("department_id") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  credential                   UserCredential?
  sessions                     AuthSession[]
  roleAssignment               UserRoleAssignment?
  department                   Department?                  @relation("DepartmentEmployees", fields: [departmentId], references: [id], onDelete: SetNull)
  managedDepartments           Department[]                 @relation("DepartmentManager")
  managedTeams                 Team[]                       @relation("TeamManager")
  teamMemberships              TeamMembership[]
  managedWorkspaces            Workspace[]                  @relation("WorkspaceManager")
  workspaceParticipations      WorkspaceParticipant[]
  createdEvents                Event[]                      @relation("EventCreatedBy")
  createdProjects              Project[]                    @relation("ProjectCreatedBy")
  createdCampaigns             Campaign[]                   @relation("CampaignCreatedBy")
  ownedPartners                Partner[]                    @relation("PartnerOwner")
  createdPartners              Partner[]                    @relation("PartnerCreatedBy")
  partnerActivities            PartnerActivity[]            @relation("PartnerActivityAuthor")
  createdProductions           Production[]                 @relation("ProductionCreatedBy")
  createdProductionLocations   ProductionLocation[]         @relation("ProductionLocationCreatedBy")
  initiatedManagedFiles        ManagedFile[]                @relation("ManagedFileInitiator")
  workspaceFileAttachments     WorkspaceFileAttachment[]    @relation("WorkspaceFileAttachedBy")
  createdTasks                 Task[]                       @relation("TaskCreatedBy")
  taskAssignments              TaskAssignment[]             @relation("TaskAssignee")
  assignedTasks                TaskAssignment[]             @relation("TaskAssignedBy")
  taskComments                 TaskComment[]                @relation("TaskCommentAuthor")
  taskCommentMentions          TaskCommentMention[]
  taskAttachments              TaskAttachment[]             @relation("TaskAttachmentActor")
  taskReviews                  TaskReview[]                 @relation("TaskReviewer")
  taskActivities               TaskActivity[]               @relation("TaskActivityActor")
  checklistItemsCompleted      TaskChecklistItem[]          @relation("TaskChecklistItemCompletedBy")
  checklistItemsCreated        TaskChecklistItem[]          @relation("TaskChecklistItemCreatedBy")
  calendarEntries              CalendarEntry[]              @relation("CalendarEntryOwner")
  createdCalendarEntries       CalendarEntry[]              @relation("CalendarEntryCreatedBy")
  todos                        Todo[]                       @relation("TodoOwner")
  createdTodos                 Todo[]                       @relation("TodoCreatedBy")
  createdConversations         Conversation[]               @relation("ConversationCreatedBy")
  conversationMemberships      ConversationMember[]
  messages                     Message[]                    @relation("MessageAuthor")
  pinnedMessages               Message[]                    @relation("MessagePinnedBy")
  messageMentions              MessageMention[]
  messageAttachments           MessageAttachment[]          @relation("MessageAttachmentActor")
  notifications                Notification[]
  notificationPreferences      NotificationPreference[]
  organizedMeetings            Meeting[]                    @relation("MeetingOrganizer")
  meetingParticipations        MeetingParticipant[]
  managedTalents               Talent[]                     @relation("TalentManager")
  authoredReports              Report[]                     @relation("ReportAuthor")
  reviewedReports              Report[]                     @relation("ReportCurrentReviewer")
  reportReviews                ReportReview[]               @relation("ReportReviewActor")
  reportAttachments            ReportAttachment[]           @relation("ReportAttachmentActor")
  createdExpenses              Expense[]                    @relation("ExpenseCreatedBy")
  reviewedExpenses             Expense[]                    @relation("ExpenseCurrentReviewer")
  expenseReviews               ExpenseReview[]              @relation("ExpenseReviewActor")
  expenseAttachments           ExpenseAttachment[]          @relation("ExpenseAttachmentActor")
  createdSuppliers             Supplier[]                   @relation("SupplierCreatedBy")
  employeeProfile              EmployeeProfile?             @relation("EmployeeProfileUser")
  managedEmployeeProfiles      EmployeeProfile[]            @relation("EmployeeReportingManager")
  employeeStatusChanges        EmployeeProfile[]            @relation("EmployeeStatusChangedBy")
  createdEmployeeProfiles      EmployeeProfile[]            @relation("EmployeeCreatedBy")
  createdLetters               Letter[]                     @relation("LetterCreatedBy")
  updatedLetters               Letter[]                     @relation("LetterUpdatedBy")
  letterAttachments            LetterAttachment[]           @relation("LetterAttachmentActor")
  letterRemarks                LetterRemark[]               @relation("LetterRemarkAuthor")
  uploadedDocuments            Document[]                   @relation("DocumentUploadedBy")
  receivedShares               Share[]                      @relation("ShareRecipient")
  sharedByMe                   Share[]                      @relation("ShareSharedBy")
  revokedShares                Share[]                      @relation("ShareRevokedBy")
  createdAttendanceKiosks      AttendanceKiosk[]            @relation("AttendanceKioskCreatedBy")
  revokedAttendanceKiosks      AttendanceKiosk[]            @relation("AttendanceKioskRevokedBy")
  createdEventShifts           EventShift[]                 @relation("EventShiftCreatedBy")
  eventShiftAssignments        EventShiftAssignment[]       @relation("EventShiftAssignee")
  assignedEventShifts          EventShiftAssignment[]       @relation("EventShiftAssignedBy")
  unassignedEventShifts        EventShiftAssignment[]       @relation("EventShiftUnassignedBy")
  eventShiftChanges            EventShiftChange[]           @relation("EventShiftChangeActor")
  attendancePunches            AttendancePunch[]            @relation("AttendancePunchEmployee")
  attendanceSessions           AttendanceSession[]          @relation("AttendanceSessionEmployee")
  decidedOvertimeApprovals     AttendanceOvertimeApproval[] @relation("AttendanceOvertimeDecidedBy")
  attendanceExceptions         AttendanceException[]        @relation("AttendanceExceptionEmployee")
  reviewedAttendanceExceptions AttendanceException[]        @relation("AttendanceExceptionReviewedBy")
  createdAttendanceExceptions  AttendanceException[]        @relation("AttendanceExceptionCreatedBy")
  createdWeekdaySchedules      AttendanceWeekdaySchedule[]  @relation("AttendanceWeekdayScheduleCreatedBy")
  createdAttendanceHolidays    AttendanceHoliday[]          @relation("AttendanceHolidayCreatedBy")
  createdLeaveTypes            LeaveType[]                  @relation("LeaveTypeCreatedBy")
  leaveGrants                  LeaveGrant[]                 @relation("LeaveGrantEmployee")
  createdLeaveGrants           LeaveGrant[]                 @relation("LeaveGrantCreatedBy")
  leaveLedgerEntries           LeaveLedgerEntry[]           @relation("LeaveLedgerEmployee")
  createdLeaveLedgerEntries    LeaveLedgerEntry[]           @relation("LeaveLedgerCreatedBy")
  leaveRequests                LeaveRequest[]               @relation("LeaveRequestEmployee")
  reviewedLeaveRequests        LeaveRequest[]               @relation("LeaveRequestReviewedBy")

  // Administrators list and filter users by status and sort them by name.
  @@index([status])
  @@index([lastName, firstName])
  // Scoped visibility and the department roster both filter users by department.
  @@index([departmentId])
  @@map("users")
}

/// Argon2id password credential. Exactly one per user; deleted with the user.
/// `mustChangePassword` marks a credential an operator set on the user's
/// behalf (USR-02 user creation): the account can authenticate but must
/// rotate the password before doing anything else. First-login delivery and
/// enforcement details remain open in OD-01.
model UserCredential {
  id                 String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId             String    @unique @map("user_id") @db.Uuid
  passwordHash       String    @map("password_hash")
  passwordUpdatedAt  DateTime  @default(now()) @map("password_updated_at") @db.Timestamptz(6)
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  failedAttemptCount Int       @default(0) @map("failed_attempt_count")
  lockedUntil        DateTime? @map("locked_until") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_credentials")
}

/// A rotated, hashed refresh session. The raw refresh token is never stored;
/// `refresh_token_hash` holds its digest. On rotation the previous row is
/// revoked with reason `ROTATED` and linked to its successor through
/// `replaced_by_session_id`; reuse of a rotated token revokes the whole
/// `family_id`.
model AuthSession {
  id                  String                   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId              String                   @map("user_id") @db.Uuid
  familyId            String                   @map("family_id") @db.Uuid
  refreshTokenHash    String                   @unique @map("refresh_token_hash")
  issuedAt            DateTime                 @default(now()) @map("issued_at") @db.Timestamptz(6)
  expiresAt           DateTime                 @map("expires_at") @db.Timestamptz(6)
  lastUsedAt          DateTime?                @map("last_used_at") @db.Timestamptz(6)
  rotatedAt           DateTime?                @map("rotated_at") @db.Timestamptz(6)
  revokedAt           DateTime?                @map("revoked_at") @db.Timestamptz(6)
  revokedReason       SessionRevocationReason? @map("revoked_reason")
  replacedBySessionId String?                  @unique @map("replaced_by_session_id") @db.Uuid
  ipAddress           String?                  @map("ip_address") @db.Inet
  userAgent           String?                  @map("user_agent")
  createdAt           DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)

  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy AuthSession? @relation("SessionRotation", fields: [replacedBySessionId], references: [id], onDelete: SetNull)
  replaces   AuthSession? @relation("SessionRotation")

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

/// A qualifier bounding which records a grant covers. `management` is
/// `organization` scope further restricted to organization-wide management
/// data, attached only to Super Admin and Management/Administrator grants.
/// See docs/product/permission-catalog-and-role-matrix.md.
enum PermissionScope {
  ORGANIZATION
  DEPARTMENT
  TEAM
  WORKSPACE
  SELF
  MANAGEMENT

  @@map("permission_scope")
}

/// The fixed enforcement vocabulary: one `resource.action` key per authorized
/// operation, scope-free. `key` is the primary key rather than a surrogate id
/// because the catalog is referenced by this literal string throughout the
/// application, never by an opaque identifier. Rows are seed data (RBAC-01);
/// a new key is added only when a later issue introduces a newly authorized
/// operation. See docs/product/permission-catalog-and-role-matrix.md.
model Permission {
  key         String   @id
  description String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]
  baselineGrants  BaselineGrant[]

  @@map("permissions")
}

/// A configurable role: its access is entirely the set of `RolePermission`
/// grants below, with no inheritance between roles. The five SRS roles are
/// seeded rows, not code branches; `isSystem` marks them so administration
/// can protect them from deletion or rename without ever comparing a role's
/// name in code.
model Role {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]
  userAssignments UserRoleAssignment[]

  @@map("roles")
}

/// A `(role, permission key, scope)` grant. A role's effective permissions
/// are the union of its rows here; absence of a row is denial. The composite
/// primary key is the grant triple itself, so it cannot be represented twice.
model RolePermission {
  roleId        String          @map("role_id") @db.Uuid
  permissionKey String          @map("permission_key")
  scope         PermissionScope
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey, scope])
  @@index([permissionKey])
  @@map("role_permissions")
}

/// A `(permission key, scope)` grant held by every authenticated active user,
/// independent of role and additive to the role matrix. Kept separate from
/// `RolePermission` rather than as a synthetic "Baseline" role, since it is
/// not part of role administration and no user is ever assigned it directly.
/// See "Baseline grants for every authenticated user" in the permission
/// catalog.
model BaselineGrant {
  permissionKey String          @map("permission_key")
  scope         PermissionScope
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([permissionKey, scope])
  @@map("baseline_grants")
}

/// Which single role a user currently holds. Owned by RBAC (RBAC-02), not
/// USR-01: a join table rather than a column on `users`, so it requires no
/// change to that table. This is what lets guards resolve an acting user's
/// grants, and what a role needs to be free of before it can be deleted.
/// USR-01/02 later add the `user.assign_role`-gated endpoint that writes
/// here; until then, rows exist only for accounts an operator has assigned
/// directly.
model UserRoleAssignment {
  userId    String   @id @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@index([roleId])
  @@map("user_role_assignments")
}

/// A stable organizational unit that groups employees and department-owned
/// work (SRS 5.3). DEP-01 models only the unit itself and its two direct
/// relationships to `users`: `manager_id` for the Department Manager and the
/// inverse of `users.department_id` for its employees. Teams carry their own
/// `department_id` added by TEAM-01; "Active Projects/Tasks" are derived
/// summaries a later slice computes, not columns here.
///
/// `name` is unique case-sensitively at the database, matching `users.email`;
/// DEP-02 trims and normalises on write. `deactivated_at` (NULL = active) is
/// the safe-deactivation marker only — departments have no SRS status field
/// and the archive/delete/reassignment policy is OD-02.
model Department {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name          String    @unique
  description   String?
  managerId     String?   @map("manager_id") @db.Uuid
  /// Set when the department is deactivated and cleared on reactivation;
  /// NULL means active.
  deactivatedAt DateTime? @map("deactivated_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  manager       User?          @relation("DepartmentManager", fields: [managerId], references: [id], onDelete: SetNull)
  employees     User[]         @relation("DepartmentEmployees")
  teams         Team[]
  tasks         Task[]
  conversations Conversation[]
  reports       Report[]
  events        Event[]
  expenses      Expense[]
  suppliers     Supplier[]
  productions   Production[]
  campaigns     Campaign[]
  partners      Partner[]

  // Look up the departments a user manages, and list active departments.
  @@index([managerId])
  @@index([deactivatedAt])
  @@map("departments")
}

/// A working group owned by exactly one department (SRS 5.4). TEAM-01 models
/// the unit, its manager slot, and its membership join table; the derived
/// "Active Projects/Events" summaries and the team-to-work assignments
/// (events, projects, campaigns, tasks) belong to later slices and add no
/// column here.
///
/// `department_id` is required: a team is always department-owned, which is
/// what makes `team.read` at `department` scope resolvable. The FK is
/// `ON DELETE RESTRICT` rather than cascading, so the archive / delete /
/// reassignment policy for a department that still owns teams stays open in
/// OD-02 instead of being silently decided here; a later slice widens
/// DEP-02's "in use" check to cover owned teams.
///
/// `name` is unique per department (case-sensitively, matching
/// `departments.name` and `users.email`); TEAM-02 trims and normalises on
/// write. `deactivated_at` (NULL = active) is the safe-deactivation marker
/// only, mirroring `departments`.
model Team {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name          String
  description   String?
  departmentId  String    @map("department_id") @db.Uuid
  managerId     String?   @map("manager_id") @db.Uuid
  /// Set when the team is deactivated and cleared on reactivation;
  /// NULL means active.
  deactivatedAt DateTime? @map("deactivated_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  department    Department       @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  manager       User?            @relation("TeamManager", fields: [managerId], references: [id], onDelete: SetNull)
  members       TeamMembership[]
  workspaces    WorkspaceTeam[]
  conversations Conversation[]

  // A department cannot hold two teams of the same name; this index also
  // serves the department-scoped team list.
  @@unique([departmentId, name])
  // Look up the teams a user manages, and list active teams.
  @@index([managerId])
  @@index([deactivatedAt])
  @@map("teams")
}

/// The explicit user-to-team relationship (SRS 5.4 "Team Members"). The
/// composite primary key is the pair itself, so a user cannot be recorded in
/// the same team twice. Both sides cascade: membership is pure join data with
/// no meaning once either the team or the user is gone. Approved
/// responsibility / membership metadata, if a requirement lands, is added by
/// TEAM-02; the lifecycle of a membership is OD-02.
model TeamMembership {
  teamId    String   @map("team_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  // List every team a given user belongs to.
  @@index([userId])
  @@map("team_memberships")
}

/// Which module owns the work behind a workspace root. This is an explicit
/// discriminator, not a polymorphic `entity_type` string: the owning module
/// record (an event, a project, a production project, or a campaign, all
/// delivered by later epics) points back at its `Workspace` with a unique
/// `workspace_id`, and `kind` records which of those four it is. Production
/// and project are kept distinct because Production Management retains
/// ownership of production projects (see product vocabulary) even though both
/// follow the common project lifecycle.
enum WorkspaceKind {
  EVENT
  PROJECT
  PRODUCTION
  CAMPAIGN

  @@map("workspace_kind")
}

/// The organization-owned ownership and authorization anchor for one unit of
/// connected work (SRS 5.5 Event Workspace, 5.7 Production, 5.8 Promotion).
/// WSP-01 models only the root and its shared manager, team, and participant
/// relations; the connected records themselves (tasks, meetings, files,
/// discussions, reports, calendar projections) stay owned by their modules and
/// link back through explicit per-module relations added by later slices, never
/// a generic `related_entity_type` / `related_entity_id` pair.
///
/// The root carries no name, description, or status: those belong to the owning
/// module record, whose lifecycle (Planning / Ready / Completed, Planned /
/// Active / Completed, ...) is not duplicated here. Any archive or deactivate
/// marker for a workspace is deferred with OD-02.
model Workspace {
  id        String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  kind      WorkspaceKind
  /// The user who manages this workspace and, through that assignment, holds
  /// the `workspace`-scoped permission set for it (permission catalog, "Entity
  /// manager assignments"). Cleared, not cascaded, when the user row is
  /// removed; NULL means unassigned.
  managerId String?       @map("manager_id") @db.Uuid
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  manager           User?                     @relation("WorkspaceManager", fields: [managerId], references: [id], onDelete: SetNull)
  teams             WorkspaceTeam[]
  participants      WorkspaceParticipant[]
  fileAttachments   WorkspaceFileAttachment[]
  /// The parent authorized when an upload intent is issued. This remains
  /// explicit until finalization creates the attachment, preventing an intent
  /// from being replayed against another workspace.
  fileUploadIntents ManagedFile[]             @relation("ManagedFileIntentWorkspace")
  /// The one module record that owns this workspace, when its `kind` is
  /// `EVENT`, `PROJECT`, or `CAMPAIGN`. A later epic adds the equivalent
  /// inverse for production.
  event             Event?
  project           Project?
  campaign          Campaign?
  production        Production?
  tasks             Task[]
  meetings          Meeting[]
  conversations     Conversation[]
  reportLinks       ReportWorkspace[]

  // "Workspaces of kind X" and "workspaces a user manages" are the two root
  // access patterns.
  @@index([kind])
  @@index([managerId])
  @@map("workspaces")
}

/// The backend-governed lifecycle of an opaque stored object. `PENDING` is an
/// authorized but unfinalized upload intent, `AVAILABLE` is a verified object
/// with an approved explicit attachment, and `UNAVAILABLE` is an expired,
/// rejected, detached, or missing object awaiting the cleanup lifecycle. This
/// is storage metadata, not a product-workflow status (see ADR 0002).
enum ManagedFileState {
  PENDING
  AVAILABLE
  UNAVAILABLE

  @@map("managed_file_state")
}

/// Authoritative metadata for one private S3-compatible object (ADR 0002).
/// The opaque `storageKey` is unique but never a browser/API contract, and
/// bucket/provider configuration remains in the backend infrastructure
/// adapter. The eventual FIL-02 upload/finalize flow owns state transitions;
/// this data slice only persists the validated intent, verification, and
/// retention information required to make those transitions safe.
model ManagedFile {
  id                   String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// API-generated opaque object reference. It contains no filename, actor,
  /// workspace, bucket, provider URL, or presigned URL.
  storageKey           String           @unique @map("storage_key")
  originalFilename     String           @map("original_filename")
  declaredMediaType    String           @map("declared_media_type")
  declaredSizeBytes    Int              @map("declared_size_bytes")
  verifiedMediaType    String?          @map("verified_media_type")
  verifiedSizeBytes    Int?             @map("verified_size_bytes")
  state                ManagedFileState @default(PENDING)
  /// PENDING intents expire after 24 hours. The timestamp is retained as
  /// lifecycle evidence after finalization rather than being rewritten.
  intentExpiresAt      DateTime         @map("intent_expires_at") @db.Timestamptz(6)
  uploadedAt           DateTime?        @map("uploaded_at") @db.Timestamptz(6)
  availableAt          DateTime?        @map("available_at") @db.Timestamptz(6)
  unavailableAt        DateTime?        @map("unavailable_at") @db.Timestamptz(6)
  /// The earliest retention-cleanup time. It is populated only when a file is
  /// unavailable; a later lifecycle service applies the 7-day orphan or
  /// 30-day detached-file policy from ADR 0002.
  cleanupAfter         DateTime?        @map("cleanup_after") @db.Timestamptz(6)
  initiatedById        String?          @map("initiated_by_id") @db.Uuid
  /// Nullable only to preserve any pre-FIL-02 pending records during the
  /// migration. FIL-02 creates every new intent with this explicit parent.
  intentWorkspaceId    String?          @map("intent_workspace_id") @db.Uuid
  /// Explicit task authorized for a task-scoped upload intent. At most one
  /// intent parent is set; nullable for historical pre-FIL-02 rows.
  intentTaskId         String?          @map("intent_task_id") @db.Uuid
  /// Explicit conversation authorized for a message-scoped upload intent
  /// (DSC-01), the same "authorize against an existing parent, attach once
  /// the child record exists" shape `intentTaskId` already established. At
  /// most one intent parent is set.
  intentConversationId String?          @map("intent_conversation_id") @db.Uuid
  /// Explicit talent profile authorized for a profile-image upload intent.
  /// At most one intent parent is set, matching the existing workspace,
  /// task, and conversation intent boundary.
  intentTalentId       String?          @map("intent_talent_id") @db.Uuid
  /// Explicit expense authorized for a receipt/invoice upload intent (EOM-01),
  /// the same boundary as every other intent parent above. At most one intent
  /// parent is set.
  intentExpenseId      String?          @map("intent_expense_id") @db.Uuid
  /// Explicit report authorized for a report-scoped upload intent, the same
  /// boundary as every other intent parent above. At most one intent parent
  /// is set.
  intentReportId       String?          @map("intent_report_id") @db.Uuid
  /// Explicit letter authorized for a letter-attachment upload intent, the
  /// same boundary as every other intent parent above. At most one intent
  /// parent is set.
  intentLetterId       String?          @map("intent_letter_id") @db.Uuid
  /// Explicit document shell (created with no file yet via `POST /documents`)
  /// authorized for a standalone document upload intent - the same
  /// "parent record exists first, then its file is attached" shape as every
  /// other intent parent above. At most one intent parent is set.
  intentDocumentId     String?          @map("intent_document_id") @db.Uuid
  /// Explicit leave request authorized for a supporting-document upload
  /// intent - the same boundary as every other intent parent above. At
  /// most one intent parent is set.
  intentLeaveRequestId String?          @map("intent_leave_request_id") @db.Uuid
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  initiatedBy          User?                     @relation("ManagedFileInitiator", fields: [initiatedById], references: [id], onDelete: SetNull)
  intentWorkspace      Workspace?                @relation("ManagedFileIntentWorkspace", fields: [intentWorkspaceId], references: [id], onDelete: Restrict)
  intentTask           Task?                     @relation("ManagedFileIntentTask", fields: [intentTaskId], references: [id], onDelete: Restrict)
  intentConversation   Conversation?             @relation("ManagedFileIntentConversation", fields: [intentConversationId], references: [id], onDelete: Restrict)
  intentTalent         Talent?                   @relation("ManagedFileIntentTalent", fields: [intentTalentId], references: [id], onDelete: Restrict)
  intentExpense        Expense?                  @relation("ManagedFileIntentExpense", fields: [intentExpenseId], references: [id], onDelete: Restrict)
  intentReport         Report?                   @relation("ManagedFileIntentReport", fields: [intentReportId], references: [id], onDelete: Restrict)
  intentLetter         Letter?                   @relation("ManagedFileIntentLetter", fields: [intentLetterId], references: [id], onDelete: Restrict)
  intentDocument       Document?                 @relation("ManagedFileIntentDocument", fields: [intentDocumentId], references: [id], onDelete: Restrict)
  intentLeaveRequest   LeaveRequest?             @relation("ManagedFileIntentLeaveRequest", fields: [intentLeaveRequestId], references: [id], onDelete: Restrict)
  workspaceAttachments WorkspaceFileAttachment[]
  taskAttachments      TaskAttachment[]
  messageAttachments   MessageAttachment[]
  expenseAttachments   ExpenseAttachment[]
  reportAttachments    ReportAttachment[]
  talentProfileImage   Talent?                   @relation("TalentProfileImage")
  letterAttachments    LetterAttachment[]
  document             Document?                 @relation("DocumentFile")
  leaveRequestDocument LeaveRequest?             @relation("LeaveRequestSupportingDocument")

  // Upload expiry, cleanup sweeps, actor investigation, and resolving a
  // file's approved parent are the storage access patterns.
  @@index([state, intentExpiresAt])
  @@index([state, cleanupAfter])
  @@index([initiatedById])
  @@index([intentWorkspaceId])
  @@index([intentTaskId])
  @@index([intentConversationId])
  @@index([intentTalentId])
  @@index([intentExpenseId])
  @@index([intentReportId])
  @@index([intentLetterId])
  @@index([intentDocumentId])
  @@index([intentLeaveRequestId])
  @@map("managed_files")
}

/// Explicit attachment of a managed file to the connected workspace that
/// authorizes it. This intentionally does not use an unchecked generic
/// `entityType`/`entityId` relation; later parent modules add their own
/// concrete attachment tables rather than widening this association.
model WorkspaceFileAttachment {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId   String   @map("workspace_id") @db.Uuid
  managedFileId String   @map("managed_file_id") @db.Uuid
  attachedById  String?  @map("attached_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Restrict deletion so a later lifecycle service must explicitly detach the
  // association and transition the managed file before either parent is removed.
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  managedFile ManagedFile @relation(fields: [managedFileId], references: [id], onDelete: Restrict)
  attachedBy  User?       @relation("WorkspaceFileAttachedBy", fields: [attachedById], references: [id], onDelete: SetNull)

  // The same file cannot be attached to the same workspace twice; the reverse
  // lookup resolves explicit parent context before an authorized download.
  @@unique([workspaceId, managedFileId])
  @@index([managedFileId])
  @@index([attachedById])
  @@map("workspace_file_attachments")
}

/// A team explicitly assigned to a workspace (SRS 5.4 "Teams can be assigned to
/// events, projects, campaigns, and tasks"). The composite primary key is the
/// pair itself, so a team cannot be assigned to the same workspace twice. Both
/// sides cascade: the assignment is pure join data with no meaning once either
/// the workspace or the team is gone.
model WorkspaceTeam {
  workspaceId String   @map("workspace_id") @db.Uuid
  teamId      String   @map("team_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([workspaceId, teamId])
  // List every workspace a given team is assigned to.
  @@index([teamId])
  @@map("workspace_teams")
}

/// A user who individually participates in a workspace (an assigned employee,
/// distinct from being on an assigned team). The composite primary key is the
/// pair, so a user cannot be recorded in the same workspace twice. Both sides
/// cascade: participation is pure join data. Approved participation metadata
/// (role in the workspace, who assigned it), if a requirement lands, is added
/// by a later slice; the EVE-33 audit catalog already records the actor of an
/// assignment change.
model WorkspaceParticipant {
  workspaceId String   @map("workspace_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  // List every workspace a given user participates in.
  @@index([userId])
  @@map("workspace_participants")
}

/// User-facing urgency for task planning and filtering (SRS 6.1).
enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT

  @@map("task_priority")
}

/// The kind of work a task represents. A small, department-agnostic set
/// shared by every task regardless of owning workspace or department -
/// mirrors `TaskPriority`'s plain, non-polymorphic shape.
enum TaskType {
  GENERAL
  PLANNING
  LOGISTICS
  CREATIVE
  TECHNICAL
  ADMINISTRATIVE
  REVIEW

  @@map("task_type")
}

/// Persistent task lifecycle state. Approval and change-request decisions are
/// review outcomes below rather than duplicate task states: an approval moves
/// an under-review task to COMPLETED, while a change request returns it to
/// IN_PROGRESS in the domain workflow delivered by TSK-02.
enum TaskStatus {
  TODO
  IN_PROGRESS
  UNDER_REVIEW
  BLOCKED
  COMPLETED
  CANCELLED

  @@map("task_status")
}

enum TaskReviewOutcome {
  APPROVED
  CHANGES_REQUESTED

  @@map("task_review_outcome")
}

/// Stable activity vocabulary for the task audit/history feed. The service
/// layer owns when entries are written; this data slice only persists the
/// append-only facts and their structured before/after details.
enum TaskActivityType {
  CREATED
  UPDATED
  ASSIGNEE_ADDED
  ASSIGNEE_REMOVED
  STATUS_CHANGED
  PROGRESS_UPDATED
  COMMENT_ADDED
  ATTACHMENT_ADDED
  REVIEW_RECORDED
  CHECKLIST_ITEM_ADDED
  CHECKLIST_ITEM_UPDATED
  CHECKLIST_ITEM_COMPLETED
  CHECKLIST_ITEM_REOPENED
  CHECKLIST_ITEM_REMOVED
  CHECKLIST_ITEM_REORDERED

  @@map("task_activity_type")
}

/// Actionable work owned by a connected workspace, a department, or both.
/// Workspace ownership connects event/project/campaign/production work without
/// a polymorphic entity-type/id pair; department ownership supports general
/// departmental work. A database CHECK requires at least one explicit owner.
model Task {
  id              String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId     String?      @map("workspace_id") @db.Uuid
  departmentId    String?      @map("department_id") @db.Uuid
  title           String
  description     String?
  priority        TaskPriority @default(MEDIUM)
  type            TaskType     @default(GENERAL)
  status          TaskStatus   @default(TODO)
  /// Server-computed from checklist items or, when subtasks exist, from the
  /// mean of direct children's own progress (subtasks always win over this
  /// task's own checklist). NULL means "not tracked" - no checklist items
  /// and no subtasks - never a fabricated 0. Never client-settable, and
  /// reaching 100 never implies review approval (TasksService.review()
  /// owns that decision independently).
  progress        Int?
  startAt         DateTime?    @map("start_at") @db.Timestamptz(6)
  dueAt           DateTime?    @map("due_at") @db.Timestamptz(6)
  /// The meeting this task was created from as an action item (EOM-01), or
  /// NULL for an ordinary task. Cleared, not cascaded, if that meeting row is
  /// removed - the task itself stays a real, assignable, trackable task.
  sourceMeetingId String?      @map("source_meeting_id") @db.Uuid
  /// The higher-level assignment this task was broken down from (e.g. a
  /// Department Manager's subordinate task created from a Super Admin's
  /// directive), or NULL for an ordinary, top-level task. Completing every
  /// subtask never auto-transitions the parent - that only happens through
  /// an explicit review/transition on the parent itself, enforced in the
  /// application layer (TasksService), not here.
  parentTaskId    String?      @map("parent_task_id") @db.Uuid
  createdById     String?      @map("created_by_id") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace       Workspace?       @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  department      Department?      @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  sourceMeeting   Meeting?         @relation(fields: [sourceMeetingId], references: [id], onDelete: SetNull)
  parent          Task?            @relation("TaskHierarchy", fields: [parentTaskId], references: [id], onDelete: SetNull)
  subtasks        Task[]           @relation("TaskHierarchy")
  createdBy       User?            @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  assignments     TaskAssignment[]
  comments        TaskComment[]
  attachments     TaskAttachment[]
  fileIntents     ManagedFile[]    @relation("ManagedFileIntentTask")
  reviews         TaskReview[]
  activities      TaskActivity[]
  checklistItems  TaskChecklistItem[]
  calendarEntries CalendarEntry[]
  notifications   Notification[]

  // List/Kanban views are owner + status scoped; calendar projections sort
  // independently by start and due time. Overdue remains a derived query.
  @@index([workspaceId, status, updatedAt])
  @@index([departmentId, status, updatedAt])
  @@index([status, dueAt])
  @@index([startAt])
  @@index([dueAt])
  @@index([priority, dueAt])
  @@index([createdById])
  @@index([sourceMeetingId])
  @@index([parentTaskId])
  @@map("tasks")
}

/// Explicit many-to-many task assignment with attribution and assignment time.
model TaskAssignment {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  taskId       String   @map("task_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  assignedById String?  @map("assigned_by_id") @db.Uuid
  assignedAt   DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  task       Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user       User  @relation("TaskAssignee", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy User? @relation("TaskAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([taskId, userId])
  @@index([userId, assignedAt])
  @@index([assignedById])
  @@map("task_assignments")
}

/// A task discussion entry. Mentions are normalized in TaskCommentMention so
/// notification work can resolve recipients without parsing comment text.
model TaskComment {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  authorId  String?  @map("author_id") @db.Uuid
  content   String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  task     Task                 @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author   User?                @relation("TaskCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  mentions TaskCommentMention[]

  @@index([taskId, createdAt])
  @@index([authorId])
  @@map("task_comments")
}

model TaskCommentMention {
  commentId String   @map("comment_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  comment TaskComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
  @@index([userId])
  @@map("task_comment_mentions")
}

/// A concrete task parent for an existing managed object. File names, media
/// types, storage keys, and lifecycle stay authoritative on ManagedFile.
model TaskAttachment {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  taskId        String   @map("task_id") @db.Uuid
  managedFileId String   @map("managed_file_id") @db.Uuid
  attachedById  String?  @map("attached_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  task        Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  managedFile ManagedFile @relation(fields: [managedFileId], references: [id], onDelete: Restrict)
  attachedBy  User?       @relation("TaskAttachmentActor", fields: [attachedById], references: [id], onDelete: SetNull)

  @@unique([taskId, managedFileId])
  @@index([managedFileId])
  @@index([attachedById])
  @@map("task_attachments")
}

/// An immutable manager decision for one review cycle. Several rows are valid
/// because a task may be changed and submitted for review more than once.
model TaskReview {
  id         String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  taskId     String            @map("task_id") @db.Uuid
  reviewerId String?           @map("reviewer_id") @db.Uuid
  outcome    TaskReviewOutcome
  note       String?
  reviewedAt DateTime          @default(now()) @map("reviewed_at") @db.Timestamptz(6)

  task     Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  reviewer User? @relation("TaskReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([taskId, reviewedAt])
  @@index([reviewerId])
  @@map("task_reviews")
}

/// Append-only history used by task detail and activity views. `details` is a
/// JSON object for event-specific before/after values, never authorization.
model TaskActivity {
  id         String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  taskId     String           @map("task_id") @db.Uuid
  actorId    String?          @map("actor_id") @db.Uuid
  type       TaskActivityType
  details    Json             @default("{}") @db.JsonB
  occurredAt DateTime         @default(now()) @map("occurred_at") @db.Timestamptz(6)

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor User? @relation("TaskActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([taskId, occurredAt])
  @@index([actorId])
  @@map("task_activities")
}

/// A single creator-defined checkpoint on a task's own work (not its
/// subtasks). Automatic progress is computed from these: completed / total,
/// rounded, with "no items" meaning "not tracked" rather than 0% or 100%.
/// CRUD on the set reuses `task.update` (the same actors who can already
/// edit title/description); toggling `completed` reuses
/// `task.update_progress` (the self-report permission, now scoped to "may
/// toggle my own assigned work's checklist" instead of "may set a number").
model TaskChecklistItem {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  taskId        String    @map("task_id") @db.Uuid
  description   String
  completed     Boolean   @default(false)
  position      Int
  completedById String?   @map("completed_by_id") @db.Uuid
  completedAt   DateTime? @map("completed_at") @db.Timestamptz(6)
  createdById   String?   @map("created_by_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  task        Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  completedBy User? @relation("TaskChecklistItemCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  createdBy   User? @relation("TaskChecklistItemCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([taskId, position])
  @@map("task_checklist_items")
}

/// The kind of event (SRS 5.5 "Event Types"). `OTHER` is the SRS fallback.
/// Whether these baseline types are renameable / deactivatable, and who may
/// supply the value behind an "Other" event, are open in OD-17; modelled as a
/// fixed enum for now (matching `WorkspaceKind`), and a later approved
/// decision that makes types configurable migrates this to a reference table.
enum EventType {
  FILM_PREMIERE
  CONCERT
  ALBUM_RELEASE
  PRODUCT_LAUNCH
  CORPORATE_EVENT
  PROMOTIONAL_EVENT
  OTHER

  @@map("event_type")
}

/// The event lifecycle state (SRS 5.5). `PLANNING` is the initial state;
/// `COMPLETED` and `CANCELLED` are terminal. The approved transition graph is
/// `Planning -> Ready | In Progress | Cancelled`, `Ready -> In Progress |
/// Cancelled`, `In Progress -> Completed | Cancelled`. The entry criteria for
/// `READY`, whether it is mandatory, who may make each move, and whether a
/// terminal event can be reopened are open in OD-05 and enforced by EVT-02 in
/// the domain layer - a CHECK cannot express a state machine.
enum EventStatus {
  PLANNING
  READY
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@map("event_status")
}

/// One managed event (SRS 5.5). The shared operational context - the event
/// manager, the assigned teams, and the assigned employees - lives on the
/// event's connected `Workspace` (WSP-01), not here: `workspace.manager_id` is
/// the Event Manager, `workspace_teams` the assigned teams, and
/// `workspace_participants` the assigned employees. This model carries only the
/// event-specific attributes plus the one-to-one link back to that workspace.
///
/// `workspace_id` is required and unique: every event owns exactly one
/// workspace, created with it and always of `kind = EVENT` (EVT-02 sets that
/// pairing; a plain foreign key cannot cross-check the discriminator). The FK
/// is `ON DELETE RESTRICT` so a workspace an event still owns cannot be
/// dropped out from under it; EVT-02's delete path removes the event and then
/// its workspace in one transaction.
///
/// `organizer_name` and `location` are free text pending OD-16 (whether an
/// organizer or location is a user, a contact, free text, or a structured
/// record). `budget_amount` / `budget_currency` follow the architecture rule
/// "money as numeric with an explicit currency code"; the supported currency
/// set, rounding, and organization default are open in OD-14. The
/// event-to-talent extension (SRS `EventTalent`: role and status per assigned
/// talent) is added once Talent Management provides a `talents` table to
/// reference.
model Event {
  id             String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId    String      @unique @map("workspace_id") @db.Uuid
  name           String
  eventType      EventType   @map("event_type")
  description    String?
  /// UTC start / end of the event. Nullable: a `PLANNING` event may not be
  /// scheduled yet. A CHECK keeps `end_at` at or after `start_at` when both
  /// are set. Display time zones and all-day handling are open in OD-15;
  /// storage stays UTC.
  startAt        DateTime?   @map("start_at") @db.Timestamptz(6)
  endAt          DateTime?   @map("end_at") @db.Timestamptz(6)
  /// Optional reminder instant. A CHECK requires `start_at` to be set and
  /// `reminder_at` to be at or before it - "remind me before X" is
  /// meaningless with no X. Mirrors `Meeting.reminderAt` exactly.
  reminderAt     DateTime?   @map("reminder_at") @db.Timestamptz(6)
  location       String?
  organizerName  String?     @map("organizer_name")
  status         EventStatus @default(PLANNING)
  /// Optional budget. A CHECK requires the amount and the ISO-4217 currency
  /// code to be set together, the amount to be non-negative, and the code to
  /// be three upper-case letters.
  budgetAmount   Decimal?    @map("budget_amount") @db.Decimal(14, 2)
  budgetCurrency String?     @map("budget_currency") @db.Char(3)
  /// The owning department, or NULL for events predating department-scoped
  /// access (EOM-01). NULL stays organization-only visible - the migration
  /// backfill never guesses an owner for a pre-existing event. Cleared, not
  /// cascaded, if that department row is removed.
  departmentId   String?     @map("department_id") @db.Uuid
  /// The user who created the event; cleared, not cascaded, if that user row
  /// is removed.
  createdById    String?     @map("created_by_id") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace         Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  department        Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdBy         User?           @relation("EventCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  /// General projects that optionally relate to this event (PRJ-01). A soft,
  /// unbounded cross-reference between peers, not ownership - deleting the
  /// event clears it on each project rather than being blocked.
  projects          Project[]
  /// Campaigns that optionally relate to this event (CAM-01), with the same
  /// soft cross-reference semantics as `projects`.
  campaigns         Campaign[]
  /// Productions that optionally relate to this event (EOM-01), the same
  /// soft cross-reference semantics as `projects`/`campaigns`.
  productions       Production[]
  calendarEntries   CalendarEntry[]
  notifications     Notification[]
  todos             Todo[]
  talentAssignments EventTalent[]
  expenses          Expense[]
  partners          Partner[]
  shifts            EventShift[]

  // Administration and the connected-workspace overview filter events by
  // lifecycle state, type, schedule, author, and (EOM-01) owning department.
  @@index([status])
  @@index([eventType])
  @@index([startAt])
  @@index([createdById])
  @@index([departmentId, status])
  @@map("events")
}

/// Baseline classifications named by SRS 5.6. Extensibility, rename, and
/// deactivation semantics remain OD-17; this first data slice uses the
/// approved fixed vocabulary rather than introducing speculative type
/// administration.
enum TalentType {
  ARTIST
  INFLUENCER
  ACTOR
  MUSICIAN
  MODEL
  PRESENTER
  CONTENT_CREATOR

  @@map("talent_type")
}

/// The single operational-state concept reconciled from the SRS Availability
/// and Status fields. Whether ASSIGNED is stored or derived is still OD-04;
/// this slice stores the approved state and leaves transition policy to
/// TAL-02.
enum TalentAvailability {
  AVAILABLE
  ASSIGNED
  UNAVAILABLE
  INACTIVE

  @@map("talent_availability")
}

/// Lifecycle of an explicit event-to-talent engagement (SRS EventTalent).
enum TalentAssignmentStatus {
  ASSIGNED
  COMPLETED
  CANCELLED

  @@map("talent_assignment_status")
}

/// A managed creative professional. A Talent is not necessarily a platform
/// User; manager assignment is the only optional user relation. Profile
/// images reference the secure managed-file record rather than a public URL.
/// Production, campaign, and promotion assignments are added by their owning
/// M5 data slices once concrete target tables exist.
model Talent {
  id             String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  fullName       String             @map("full_name")
  type           TalentType
  profileImageId String?            @unique @map("profile_image_id") @db.Uuid
  email          String?
  phone          String?
  biography      String?
  availability   TalentAvailability @default(AVAILABLE)
  managerId      String?            @map("manager_id") @db.Uuid
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  profileImage          ManagedFile?              @relation("TalentProfileImage", fields: [profileImageId], references: [id], onDelete: Restrict)
  manager               User?                     @relation("TalentManager", fields: [managerId], references: [id], onDelete: SetNull)
  socialLinks           TalentSocialLink[]
  schedules             TalentSchedule[]
  eventAssignments      EventTalent[]
  productionAssignments ProductionTalent[]
  promotionAssignments  PromotionActivityTalent[]
  fileUploadIntents     ManagedFile[]             @relation("ManagedFileIntentTalent")

  // Talent directories filter by type/state and manager; name and email
  // support deterministic administration lookups.
  @@index([availability, fullName])
  @@index([type, availability])
  @@index([managerId])
  @@index([email])
  @@map("talents")
}

/// Normalized social/contact link. A talent may have several accounts on the
/// same service, but the exact URL cannot be attached to the profile twice.
model TalentSocialLink {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  talentId  String   @map("talent_id") @db.Uuid
  label     String
  url       String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  talent Talent @relation(fields: [talentId], references: [id], onDelete: Cascade)

  @@unique([talentId, url])
  @@index([talentId, label])
  @@map("talent_social_links")
}

/// An explicit calendar interval owned by a talent profile. Event assignment
/// intervals remain authoritative on Event; TAL-02 uses both sources when it
/// implements availability/conflict policy.
model TalentSchedule {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  talentId  String   @map("talent_id") @db.Uuid
  title     String
  startAt   DateTime @map("start_at") @db.Timestamptz(6)
  endAt     DateTime @map("end_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  talent Talent @relation(fields: [talentId], references: [id], onDelete: Cascade)

  @@index([talentId, startAt, endAt])
  @@map("talent_schedules")
}

/// The SRS EventTalent relationship, with engagement-specific role and
/// lifecycle state kept on the join rather than the Talent profile or Event.
model EventTalent {
  id         String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  eventId    String                 @map("event_id") @db.Uuid
  talentId   String                 @map("talent_id") @db.Uuid
  role       String
  status     TalentAssignmentStatus @default(ASSIGNED)
  assignedAt DateTime               @default(now()) @map("assigned_at") @db.Timestamptz(6)
  updatedAt  DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  talent Talent @relation(fields: [talentId], references: [id], onDelete: Cascade)

  @@unique([eventId, talentId])
  @@index([eventId, status])
  @@index([talentId, status])
  @@map("event_talents")
}

enum ProductionStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED

  @@map("production_status")
}

/// Arrangement/readiness state for a production's location (PROD-WS). Mirrors
/// the SRS's plain pending/in-progress/confirmed/ready vocabulary - not the
/// richer Event/Expense lifecycles, since a location has no review workflow.
enum ProductionLocationStatus {
  PENDING
  IN_PROGRESS
  CONFIRMED
  READY

  @@map("production_location_status")
}

/// A specialized production project. Its manager, members, tasks, calendar,
/// discussions, meetings and files are owned by its `PRODUCTION` workspace.
/// `production_type` is free text because no controlled vocabulary is approved.
model Production {
  id             String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId    String           @unique @map("workspace_id") @db.Uuid
  name           String
  productionType String           @map("production_type")
  description    String?
  startAt        DateTime?        @map("start_at") @db.Timestamptz(6)
  endAt          DateTime?        @map("end_at") @db.Timestamptz(6)
  deadlineAt     DateTime?        @map("deadline_at") @db.Timestamptz(6)
  status         ProductionStatus @default(PLANNED)
  /// Optional relationship to an event (EOM-01), mirroring `Campaign.eventId`'s
  /// soft, unbounded cross-reference semantics - not an ownership relation.
  eventId        String?          @map("event_id") @db.Uuid
  /// Department ownership (PROD-WS), the same optional, explicitly-assigned
  /// shape `Event.departmentId` already established: a pre-existing row keeps
  /// `NULL` (organization-only visibility) until someone with an
  /// organization-scope grant assigns it.
  departmentId   String?          @map("department_id") @db.Uuid
  /// Approved/allocated budget for this production (sensitive, same
  /// "separately gated" idiom as `Event.budgetAmount`). Actual and committed
  /// spend are never stored here - they are computed live from `Expense` rows
  /// linked either directly to this production or to its linked event.
  budgetAmount   Decimal?         @map("budget_amount") @db.Decimal(14, 2)
  budgetCurrency String?          @map("budget_currency") @db.Char(3)
  createdById    String?          @map("created_by_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace  Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  event      Event?               @relation(fields: [eventId], references: [id], onDelete: SetNull)
  department Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdBy  User?                @relation("ProductionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  talents    ProductionTalent[]
  locations  ProductionLocation[]
  expenses   Expense[]

  @@index([status])
  @@index([productionType, status])
  @@index([deadlineAt])
  @@index([createdById])
  @@index([eventId])
  @@index([departmentId, status])
  @@map("productions")
}

/// A physical location a production needs arranged (rehearsal space, shoot
/// location, venue) - distinct from `Supplier` (vendor/contact directory) and
/// from `Event.location` (a single plain-text venue string on the event
/// itself). A production may need several.
model ProductionLocation {
  id           String                   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  productionId String                   @map("production_id") @db.Uuid
  name         String
  address      String?
  description  String?
  contactName  String?                  @map("contact_name")
  contactEmail String?                  @map("contact_email")
  contactPhone String?                  @map("contact_phone")
  status       ProductionLocationStatus @default(PENDING)
  notes        String?
  createdById  String?                  @map("created_by_id") @db.Uuid
  createdAt    DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  production Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  createdBy  User?      @relation("ProductionLocationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([productionId, status])
  @@map("production_locations")
}

model ProductionTalent {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  productionId String   @map("production_id") @db.Uuid
  talentId     String   @map("talent_id") @db.Uuid
  role         String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  production Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  talent     Talent     @relation(fields: [talentId], references: [id], onDelete: Cascade)

  @@unique([productionId, talentId])
  @@index([talentId])
  @@map("production_talents")
}

/// The general-project lifecycle state (SRS 9; product vocabulary "General
/// project"). `PLANNED` is the initial state; `COMPLETED` and `CANCELLED` are
/// terminal. The approved transition graph is `Planned -> Active | Cancelled`,
/// `Active -> Completed | Cancelled` - the same shape as `EventStatus`. Entry
/// criteria for `ACTIVE`/`COMPLETED`, who may make each move, and whether a
/// terminal project can be reopened are open in OD-03 and enforced by PRJ-02
/// in the domain layer - a CHECK cannot express a state machine.
enum ProjectStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED

  @@map("project_status")
}

/// One general project (SRS 9; product vocabulary "Project" / "General
/// project"). Production Management's specialized projects are a distinct
/// model owned by the PRD epic (workspace `kind = PRODUCTION`); this table
/// never carries a type discriminator because its workspace is always
/// `kind = PROJECT`, the same reasoning that keeps `Event` discriminator-free.
///
/// The shared operational context - the project manager, the assigned teams,
/// and the assigned employees - lives on the project's connected `Workspace`
/// (WSP-01), not here: `workspace.manager_id` is the project manager,
/// `workspace_teams` the assigned teams, and `workspace_participants` the
/// assigned employees. This model carries only the project-specific
/// attributes plus the one-to-one link back to that workspace.
///
/// `workspace_id` is required and unique: every project owns exactly one
/// workspace, created with it and always of `kind = PROJECT` (PRJ-02 sets
/// that pairing; a plain foreign key cannot cross-check the discriminator).
/// The FK is `ON DELETE RESTRICT` so a workspace a project still owns cannot
/// be dropped out from under it; PRJ-02's delete path removes the project and
/// then its workspace in one transaction.
///
/// `event_id` is the optional relationship to an event the product vocabulary
/// describes ("Project"): a soft, unbounded cross-reference between peers,
/// `ON DELETE SET NULL` because it is not an ownership relationship. The
/// equally-described optional relationship to a campaign is deferred until
/// Campaign Management (CAM-01) provides a `campaigns` table to reference.
///
/// Progress is deliberately **not** a stored column: OD-03 leaves how it is
/// calculated open, and the issue requires it to be computed from
/// authoritative work (tasks) rather than held as redundant, staleness-prone
/// data. It is added once Task Management provides the source to compute it
/// from. Budget is out of scope for general projects per the PRJ epic's
/// stated scope (unlike events, which do carry one).
model Project {
  id          String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId String        @unique @map("workspace_id") @db.Uuid
  name        String
  description String?
  /// UTC start / end of the project. Nullable: a `PLANNED` project may not be
  /// scheduled yet. A CHECK keeps `end_at` at or after `start_at` when both
  /// are set. Display time zones and all-day handling are open in OD-15;
  /// storage stays UTC.
  startAt     DateTime?     @map("start_at") @db.Timestamptz(6)
  endAt       DateTime?     @map("end_at") @db.Timestamptz(6)
  status      ProjectStatus @default(PLANNED)
  eventId     String?       @map("event_id") @db.Uuid
  /// The user who created the project; cleared, not cascaded, if that user
  /// row is removed.
  createdById String?       @map("created_by_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  event           Event?          @relation(fields: [eventId], references: [id], onDelete: SetNull)
  createdBy       User?           @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  calendarEntries CalendarEntry[]
  todos           Todo[]
  letters         Letter[]
  documents       Document[]

  // Administration and the connected-workspace overview filter projects by
  // lifecycle state, related event, schedule, and author.
  @@index([status])
  @@index([eventId])
  @@index([startAt])
  @@index([createdById])
  @@map("projects")
}

/// The ownership classification of a campaign (product vocabulary "Campaign
/// type"): Marketing or Promotion. The SRS labels Advertising and Social Media
/// are promotion channels, not separate owning modules, so they are not values
/// here; channels belong to Promotion Management (PRO-01).
enum CampaignType {
  MARKETING
  PROMOTION

  @@map("campaign_type")
}

/// The common campaign lifecycle for marketing and promotion campaigns.
/// `PLANNED` is the initial state; `COMPLETED` and `CANCELLED` are terminal.
/// The approved transition graph is `Planned -> Active | Cancelled`, `Active ->
/// Completed | Cancelled`. Entry criteria, transition authority, and reopening
/// are open in OD-03 and enforced by CAM-02 in the domain layer - a CHECK
/// cannot express a state machine.
enum CampaignStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED

  @@map("campaign_status")
}

/// The state of one planned campaign activity. The product vocabulary defines
/// an activity as a planned unit of work but publishes no lifecycle for it, so
/// this is the minimal work-item vocabulary needed to derive campaign progress
/// (OD-13); it does not duplicate `TaskStatus`, because an activity is not
/// automatically a task.
enum CampaignActivityStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@map("campaign_activity_status")
}

/// One campaign shared by Marketing and Promotion Management (SRS 5.8, 5.9;
/// product vocabulary "Campaign"). Marketing- and promotion-specific data
/// (strategies, channels, promotion activities) is owned by MKT and PRO and
/// references this model rather than duplicating it.
///
/// The shared operational context - the campaign manager, the assigned teams,
/// and the assigned employees - lives on the campaign's connected `Workspace`
/// (WSP-01), not here: `workspace.manager_id` is the campaign manager,
/// `workspace_teams` the assigned teams, and `workspace_participants` the
/// assigned employees. Tasks, meetings, discussions, and files attach to that
/// same workspace through their own explicit relations, so this model needs no
/// per-capability columns.
///
/// `workspace_id` is required and unique: every campaign owns exactly one
/// workspace, created with it and always of `kind = CAMPAIGN` (CAM-02 sets
/// that pairing; a plain foreign key cannot cross-check the discriminator).
/// The FK is `ON DELETE RESTRICT` so a workspace a campaign still owns cannot
/// be dropped out from under it; CAM-02's delete path removes the campaign and
/// then its workspace in one transaction.
///
/// The SRS "Related Event / Product" subject is modelled without an unchecked
/// polymorphic pair: `event_id` is a real foreign key (`ON DELETE SET NULL`,
/// a soft cross-reference between peers, not ownership) and `product_name` is
/// free text, because the SRS does not define Product as an independently
/// managed module. A CHECK allows at most one of the two, so a campaign has
/// one related subject or none.
///
/// Progress is deliberately **not** a stored column: OD-13 leaves how it is
/// calculated open, and it is derived from authoritative work (campaign
/// activities and connected tasks) rather than held as redundant,
/// staleness-prone data - the same decision `Project` made. Talent
/// assignments are added by the talent/promotion slices that own them, and
/// calendar projection by the calendar-integration slice.
model Campaign {
  id             String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId    String         @unique @map("workspace_id") @db.Uuid
  name           String
  campaignType   CampaignType   @map("campaign_type")
  description    String?
  /// The target audience described in the SRS; free text pending a structured
  /// audience decision.
  audience       String?
  /// UTC start / end of the campaign. Nullable: a `PLANNED` campaign may not
  /// be scheduled yet. A CHECK keeps `end_at` at or after `start_at` when both
  /// are set. Display time zones and all-day handling are open in OD-15;
  /// storage stays UTC.
  startAt        DateTime?      @map("start_at") @db.Timestamptz(6)
  endAt          DateTime?      @map("end_at") @db.Timestamptz(6)
  status         CampaignStatus @default(PLANNED)
  eventId        String?        @map("event_id") @db.Uuid
  /// The owning department (e.g. Marketing), independent of the campaign's
  /// own workspace/event links - lets a Department Manager's DEPARTMENT-scope
  /// `campaign.*` grants resolve the same way every other department-scoped
  /// resource does. NULL for a campaign with no department owner.
  departmentId   String?        @map("department_id") @db.Uuid
  productName    String?        @map("product_name")
  /// Optional budget. A CHECK requires the amount and the ISO-4217 currency
  /// code to be set together, the amount to be non-negative, and the code to
  /// be three upper-case letters (OD-14 owns the supported set and rounding).
  budgetAmount   Decimal?       @map("budget_amount") @db.Decimal(14, 2)
  budgetCurrency String?        @map("budget_currency") @db.Char(3)
  /// The user who created the campaign; cleared, not cascaded, if that user
  /// row is removed.
  createdById    String?        @map("created_by_id") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace           Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  event               Event?              @relation(fields: [eventId], references: [id], onDelete: SetNull)
  department          Department?         @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdBy           User?               @relation("CampaignCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  activities          CampaignActivity[]
  marketing           MarketingCampaign?
  promotionActivities PromotionActivity[]
  expenses            Expense[]
  partners            Partner[]

  // Supports a composite FK that fixes promotion detail ownership to PROMOTION.
  @@unique([id, campaignType])
  // Administration and the connected-workspace overview filter campaigns by
  // owning module, lifecycle state, related event, schedule, and author.
  @@index([campaignType, status])
  @@index([status])
  @@index([eventId])
  @@index([departmentId])
  @@index([startAt])
  @@index([createdById])
  @@map("campaigns")
}

/// A planned unit of work owned by one campaign (product vocabulary "Campaign
/// activity"). It may relate to tasks through the campaign's workspace but is
/// not itself a task. Activities are pure child data, so they cascade with the
/// campaign.
model CampaignActivity {
  id          String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  campaignId  String                 @map("campaign_id") @db.Uuid
  name        String
  description String?
  /// UTC start / end of the activity; a CHECK keeps `end_at` at or after
  /// `start_at` when both are set.
  startAt     DateTime?              @map("start_at") @db.Timestamptz(6)
  endAt       DateTime?              @map("end_at") @db.Timestamptz(6)
  status      CampaignActivityStatus @default(PLANNED)
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  campaign  Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  promotion PromotionActivity?

  // The promotion extension must belong to this activity's campaign.
  @@unique([id, campaignId])
  // A campaign's activity list is read by lifecycle state (progress) and by
  // schedule.
  @@index([campaignId, status])
  @@index([campaignId, startAt])
  @@map("campaign_activities")
}

/// Marketing-specific strategy for a shared MARKETING campaign. The strategy
/// is content of this campaign, not a separate lifecycle or duplicate campaign
/// record. Goals, audience, budget, status, activities, team assignments and
/// tasks remain on Campaign and its connected workspace. The composite FK and
/// constant type prevent attaching marketing content to a promotion campaign.
model MarketingCampaign {
  campaignId   String       @id @map("campaign_id") @db.Uuid
  campaignType CampaignType @default(MARKETING) @map("campaign_type")
  strategy     String
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  campaign Campaign @relation(fields: [campaignId, campaignType], references: [id, campaignType], onDelete: Cascade)

  @@unique([campaignId, campaignType])
  @@map("marketing_campaigns")
}

/// Approved promotion delivery channels (SRS 5.8). These classify promotion
/// activities, not the shared CampaignType ownership field.
enum PromotionChannel {
  CONTENT_CREATION
  SOCIAL_MEDIA
  INFLUENCER_MARKETING
  RADIO_PROMOTION
  TELEVISION
  SCREENS_DIGITAL_MEDIA
  ADVERTISING

  @@map("promotion_channel")
}

/// Promotion-specific details for an existing campaign activity. The two
/// composite FKs ensure the activity belongs to this campaign and that the
/// campaign is of PROMOTION type. Shared schedule/status/progress inputs stay
/// on CampaignActivity; tasks, teams, calendar, discuss and reports connect
/// through the campaign's workspace rather than duplicate relationships here.
model PromotionActivity {
  campaignActivityId String                    @id @map("campaign_activity_id") @db.Uuid
  campaignId         String                    @map("campaign_id") @db.Uuid
  campaignType       CampaignType              @default(PROMOTION) @map("campaign_type")
  channel            PromotionChannel
  activity           CampaignActivity          @relation(fields: [campaignActivityId, campaignId], references: [id, campaignId], onDelete: Cascade)
  campaign           Campaign                  @relation(fields: [campaignId, campaignType], references: [id, campaignType], onDelete: Cascade)
  talents            PromotionActivityTalent[]

  @@unique([campaignActivityId, campaignId])
  @@index([campaignId, channel])
  @@map("promotion_activities")
}

/// Explicit talent engagements in a promotion activity. A talent can fill
/// one role in an activity; other activities may assign that talent again.
model PromotionActivityTalent {
  id                 String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  campaignActivityId String   @map("campaign_activity_id") @db.Uuid
  talentId           String   @map("talent_id") @db.Uuid
  role               String
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  promotionActivity PromotionActivity @relation(fields: [campaignActivityId], references: [campaignActivityId], onDelete: Cascade)
  talent            Talent            @relation(fields: [talentId], references: [id], onDelete: Cascade)

  @@unique([campaignActivityId, talentId])
  @@index([talentId])
  @@map("promotion_activity_talents")
}

/// The approved meeting-type vocabulary used by the meeting domain and API.
enum MeetingType {
  PHYSICAL
  ONLINE
  HYBRID

  @@map("meeting_type")
}

enum MeetingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED

  @@map("meeting_status")
}

enum MeetingParticipantResponse {
  PENDING
  ACCEPTED
  DECLINED

  @@map("meeting_participant_response")
}

model Meeting {
  id          String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  title       String
  description String?
  type        MeetingType
  status      MeetingStatus @default(SCHEDULED)
  organizerId String        @map("organizer_id") @db.Uuid
  workspaceId String?       @map("workspace_id") @db.Uuid
  startAt     DateTime      @map("start_at") @db.Timestamptz(6)
  endAt       DateTime      @map("end_at") @db.Timestamptz(6)
  location    String?
  reminderAt  DateTime?     @map("reminder_at") @db.Timestamptz(6)
  /// Free-text meeting agenda, set before or during the meeting (EOM-01).
  agenda      String?       @db.Text
  /// Free-text minutes/notes recorded during or after the meeting (EOM-01).
  /// Action items are not stored here - they are real `Task` rows linked via
  /// `Task.sourceMeetingId`, so they stay assignable and trackable.
  minutes     String?       @db.Text
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organizer       User                 @relation("MeetingOrganizer", fields: [organizerId], references: [id], onDelete: Restrict)
  workspace       Workspace?           @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  participants    MeetingParticipant[]
  calendarEntries CalendarEntry[]
  notifications   Notification[]
  actionItems     Task[]

  @@index([organizerId, startAt])
  @@index([workspaceId, startAt])
  @@index([status, startAt])
  @@map("meetings")
}

model MeetingParticipant {
  meetingId   String                     @map("meeting_id") @db.Uuid
  userId      String                     @map("user_id") @db.Uuid
  response    MeetingParticipantResponse @default(PENDING)
  respondedAt DateTime?                  @map("responded_at") @db.Timestamptz(6)
  createdAt   DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime                   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([meetingId, userId])
  @@index([userId, response])
  @@map("meeting_participants")
}

/// The SRS calendar-entry vocabulary. Source projections keep concrete foreign
/// keys rather than an unchecked polymorphic reference.
enum CalendarEntryType {
  EVENT
  TASK
  MEETING
  PROJECT
  CAMPAIGN
  PERSONAL
  REMINDER

  @@map("calendar_entry_type")
}

/// A calendar-owned entry for one user's authorized calendar. Projections
/// retain explicit foreign keys to their source record, while personal plans
/// and reminders are owned directly by the calendar. Meeting projections are
/// written transactionally by the Meetings module.
model CalendarEntry {
  id          String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  title       String
  description String?
  type        CalendarEntryType
  startAt     DateTime          @map("start_at") @db.Timestamptz(6)
  endAt       DateTime?         @map("end_at") @db.Timestamptz(6)
  userId      String            @map("user_id") @db.Uuid
  eventId     String?           @map("event_id") @db.Uuid
  taskId      String?           @map("task_id") @db.Uuid
  projectId   String?           @map("project_id") @db.Uuid
  meetingId   String?           @map("meeting_id") @db.Uuid
  createdById String?           @map("created_by_id") @db.Uuid
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user      User     @relation("CalendarEntryOwner", fields: [userId], references: [id], onDelete: Cascade)
  event     Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  meeting   Meeting? @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  createdBy User?    @relation("CalendarEntryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([userId, eventId])
  @@unique([userId, taskId])
  @@unique([userId, projectId])
  @@unique([userId, meetingId])
  @@index([userId, startAt])
  @@index([type, startAt])
  @@index([createdById])
  @@map("calendar_entries")
}

/// SRS 5.15's To-Do types. The To-Do module is deliberately separate from
/// Task (official organizational work); these are personal planning items.
enum TodoType {
  PERSONAL
  WORK
  REMINDER
  QUICK_NOTE
  FOLLOW_UP

  @@map("todo_type")
}

enum TodoPriority {
  LOW
  MEDIUM
  HIGH
  URGENT

  @@map("todo_priority")
}

enum TodoStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED

  @@map("todo_status")
}

/// A user's private planning item (SRS 5.15) - always personal to its owner,
/// unlike Task which is official organizational work. `relatedEventId` and
/// `relatedProjectId` are optional context only, the same soft,
/// `ON DELETE SET NULL` cross-reference `Project.event` already uses:
/// deleting the referenced Event/Project clears the reference here, it never
/// removes the Todo itself (contrast `CalendarEntry`, whose projection rows
/// are genuinely owned by their source and cascade with it).
model Todo {
  id               String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId           String       @map("user_id") @db.Uuid
  title            String
  description      String?
  type             TodoType     @default(PERSONAL)
  priority         TodoPriority @default(MEDIUM)
  status           TodoStatus   @default(NOT_STARTED)
  /// A due date and its optional time of day are stored separately (SRS
  /// entity fields `dueDate`/`dueTime`) because a Todo may be due on a day
  /// without a specific time; a CHECK forbids a time without its date.
  dueDate          DateTime?    @map("due_date") @db.Date
  dueTime          DateTime?    @map("due_time") @db.Time(6)
  relatedEventId   String?      @map("related_event_id") @db.Uuid
  relatedProjectId String?      @map("related_project_id") @db.Uuid
  reminderEnabled  Boolean      @default(false) @map("reminder_enabled")
  createdById      String?      @map("created_by_id") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user           User           @relation("TodoOwner", fields: [userId], references: [id], onDelete: Cascade)
  relatedEvent   Event?         @relation(fields: [relatedEventId], references: [id], onDelete: SetNull)
  relatedProject Project?       @relation(fields: [relatedProjectId], references: [id], onDelete: SetNull)
  createdBy      User?          @relation("TodoCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  reminders      TodoReminder[]

  // "My Day"/"Upcoming" smart views filter by owner and status, sorted by
  // due date; the type index supports the Work/Personal category filter.
  @@index([userId, status, dueDate])
  @@index([userId, type])
  @@index([relatedEventId])
  @@index([relatedProjectId])
  @@index([createdById])
  @@map("todos")
}

/// An explicit reminder moment for a Todo (SRS 5.15's `TodoReminder`
/// entity), independent of the Todo's own due date/time - a floating note
/// can carry a reminder with no due date at all. This models only the
/// scheduled moment and whether it fired; the scheduler that claims due,
/// unsent rows and the TODO_REMINDER notification it produces are later
/// slices (mirrors `OutboxDelivery`'s own claim-query shape, not its
/// retry/backoff machinery, which this simpler table does not need yet).
model TodoReminder {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  todoId     String   @map("todo_id") @db.Uuid
  reminderAt DateTime @map("reminder_at") @db.Timestamptz(6)
  sent       Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  todo Todo @relation(fields: [todoId], references: [id], onDelete: Cascade)

  @@unique([todoId, reminderAt])
  @@index([sent, reminderAt])
  @@map("todo_reminders")
}

enum ConversationType {
  DIRECT
  GROUP
  CHANNEL

  @@map("conversation_type")
}

enum ChannelVisibility {
  PUBLIC
  PRIVATE

  @@map("channel_visibility")
}

/// A message container of type Direct, Group, or Channel (product vocabulary
/// "Conversation"), the same one-table-per-discriminator shape `Workspace`
/// already uses for its own four kinds. Channel-only fields - `name`,
/// `visibility`, and its optional workspace/department/team owner - are NULL
/// for DIRECT and GROUP; a CHECK keeps them in lockstep with `type` rather
/// than trusting the application layer alone. A channel's owner is at most
/// one of workspace/department/team; "approved general purpose" channels
/// (product vocabulary) have none. `workspaceId` covers an event, project,
/// production, or campaign channel uniformly, the same discriminator-free
/// link `Task.workspaceId` already uses, rather than one FK per workspace
/// kind.
model Conversation {
  id           String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  type         ConversationType
  name         String?
  visibility   ChannelVisibility?
  workspaceId  String?            @map("workspace_id") @db.Uuid
  departmentId String?            @map("department_id") @db.Uuid
  teamId       String?            @map("team_id") @db.Uuid
  createdById  String?            @map("created_by_id") @db.Uuid
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace   Workspace?           @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  department  Department?          @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  team        Team?                @relation(fields: [teamId], references: [id], onDelete: Restrict)
  createdBy   User?                @relation("ConversationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  members     ConversationMember[]
  messages    Message[]
  fileIntents ManagedFile[]        @relation("ManagedFileIntentConversation")

  // Channel discovery/listing by type, and lookups by owning
  // workspace/department/team.
  @@index([type])
  @@index([workspaceId])
  @@index([departmentId])
  @@index([teamId])
  @@map("conversations")
}

/// Explicit conversation membership plus per-user read-state evidence
/// (product vocabulary "Conversation member" / "Read state"). Both sides
/// cascade: membership and its read cursor are pure join data with no
/// meaning once either the conversation or the user is gone.
model ConversationMember {
  conversationId    String    @map("conversation_id") @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  joinedAt          DateTime  @default(now()) @map("joined_at") @db.Timestamptz(6)
  /// The last message this member has read, and when that cursor was set.
  /// NULL means nothing in the conversation has been read yet.
  lastReadMessageId String?   @map("last_read_message_id") @db.Uuid
  lastReadAt        DateTime? @map("last_read_at") @db.Timestamptz(6)

  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadMessage Message?     @relation("ConversationMemberLastRead", fields: [lastReadMessageId], references: [id], onDelete: SetNull)

  @@id([conversationId, userId])
  // List every conversation a given user belongs to.
  @@index([userId])
  @@index([lastReadMessageId])
  @@map("conversation_members")
}

/// User-authored content within a conversation (product vocabulary
/// "Message"). `parentMessageId` makes a reply explicit without a separate
/// table, mirroring how `TaskComment`/`TaskCommentMention` normalize mentions
/// rather than parsing content; a trigger keeps a reply in the same
/// conversation as its parent, since a plain FK cannot cross-check that.
///
/// `editedAt`/`deletedAt` are the Created -> Edited -> Deleted
/// resource-lifecycle evidence from the product vocabulary catalogue, not a
/// stored status enum. Deletion stays a visible tombstone (content retained,
/// not erased) until OD-08 defines deletion visibility and retention, so
/// this slice destroys no data. `pinnedAt`/`pinnedById` mark prominence
/// without changing ownership (product vocabulary "Pinned message"); a CHECK
/// keeps the pair set or clear together.
model Message {
  id              String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  conversationId  String    @map("conversation_id") @db.Uuid
  authorId        String?   @map("author_id") @db.Uuid
  parentMessageId String?   @map("parent_message_id") @db.Uuid
  content         String
  editedAt        DateTime? @map("edited_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)
  pinnedAt        DateTime? @map("pinned_at") @db.Timestamptz(6)
  pinnedById      String?   @map("pinned_by_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  conversation  Conversation         @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author        User?                @relation("MessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  parentMessage Message?             @relation("MessageReplies", fields: [parentMessageId], references: [id], onDelete: SetNull)
  replies       Message[]            @relation("MessageReplies")
  pinnedBy      User?                @relation("MessagePinnedBy", fields: [pinnedById], references: [id], onDelete: SetNull)
  readCursors   ConversationMember[] @relation("ConversationMemberLastRead")
  mentions      MessageMention[]
  attachments   MessageAttachment[]
  notifications Notification[]

  // List/search a conversation's messages in order; find a message's
  // replies; list a conversation's pinned messages.
  @@index([conversationId, createdAt])
  @@index([parentMessageId])
  @@index([conversationId, pinnedAt])
  @@index([authorId])
  @@map("messages")
}

/// Mirrors `TaskCommentMention`: normalized so notification work can resolve
/// recipients without parsing message content.
model MessageMention {
  messageId String   @map("message_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId])
  @@map("message_mentions")
}

/// A concrete message parent for an existing managed object, mirroring
/// `TaskAttachment`. File names, media types, storage keys, and lifecycle
/// stay authoritative on `ManagedFile`.
model MessageAttachment {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  messageId     String   @map("message_id") @db.Uuid
  managedFileId String   @map("managed_file_id") @db.Uuid
  attachedById  String?  @map("attached_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  message     Message     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  managedFile ManagedFile @relation(fields: [managedFileId], references: [id], onDelete: Restrict)
  attachedBy  User?       @relation("MessageAttachmentActor", fields: [attachedById], references: [id], onDelete: SetNull)

  @@unique([messageId, managedFileId])
  @@index([managedFileId])
  @@index([attachedById])
  @@map("message_attachments")
}

/// The complete initial SRS notification-type contract (ADR 0003 section 2).
/// Six of the twelve values - the MEETING_*, TODO_REMINDER, and
/// REPORT_REMINDER types - name domains (Meeting, To-Do, Report) that do not
/// exist in this schema yet; their notifications cannot carry a resolved
/// target until each domain's own schema issue extends `Notification` with
/// its own nullable target column, mirroring `taskId`/`messageId`/`eventId`
/// below. The type itself is recorded regardless, since it is just a string
/// constraint with no dependency on the target domain's tables.
enum NotificationType {
  TASK_ASSIGNED
  TASK_DUE
  TASK_OVERDUE
  TASK_APPROVED
  TASK_REJECTED
  NEW_MESSAGE
  MESSAGE_MENTION
  MEETING_INVITATION
  MEETING_REMINDER
  EVENT_REMINDER
  TODO_REMINDER
  REPORT_REMINDER
  /// EOM-01: a submitted expense notifies every user holding
  /// `expense.approve` at ORGANIZATION scope (today, Super Admin only).
  EXPENSE_SUBMITTED
  /// EOM-01: an expense decision (approved or rejected) notifies its author.
  EXPENSE_REVIEWED
  /// A submitted report notifies every active user holding `report.review`
  /// at ORGANIZATION scope, plus DEPARTMENT-scope holders in the report's
  /// own department.
  REPORT_SUBMITTED
  /// A report decision (reviewed or changes requested) notifies its author.
  REPORT_REVIEWED
  /// A partner relationship's `followUpAt` has passed; notifies its owner.
  PARTNER_FOLLOW_UP_DUE
  /// EMP-02: a letter was shared (directly or with all employees).
  LETTER_SHARED
  /// EMP-02: a document was shared (directly or with all employees).
  DOCUMENT_SHARED
  /// ATT-01: an employee was assigned to an event shift.
  ATTENDANCE_SHIFT_ASSIGNED
  /// ATT-01: an assigned shift was rescheduled, cancelled, or reinstated.
  ATTENDANCE_SHIFT_SCHEDULE_CHANGED
  /// ATT-01: a potential-overtime review was approved or rejected.
  ATTENDANCE_OVERTIME_DECIDED
  /// ATT-01: a flagged attendance exception was approved or rejected.
  ATTENDANCE_EXCEPTION_DECIDED
  /// ATT-02: notifies the employee's department manager that a leave
  /// request needs review.
  LEAVE_REQUEST_SUBMITTED
  /// ATT-02: a leave request was approved, rejected, or returned for changes.
  LEAVE_REQUEST_DECIDED

  @@map("notification_type")
}

/// ADR 0001 section 1: a domain event's actor is a user or the system itself
/// (a scheduler, a cleanup job). Unlike `AuditActorKind` this has no
/// `ANONYMOUS` value - an unauthenticated attempt never has a durable
/// consumer here.
enum OutboxActorKind {
  USER
  SYSTEM

  @@map("outbox_actor_kind")
}

enum OutboxDeliveryStatus {
  PENDING
  SUCCEEDED
  FAILED

  @@map("outbox_delivery_status")
}

/// The durable outbox event envelope (ADR 0001 section 1; ADR 0004 section 6
/// fixes the poller policy this table exists to support). Only an event with
/// at least one durable consumer gets a row here - best-effort-only domain
/// events (ADR 0001's other delivery tier) are never persisted. `id` is the
/// event's own application-assigned `eventId`, not a surrogate; the
/// `uuidv7()` default is only a safety net if a caller omits it.
/// `actorUserId` and `resourceId` intentionally have no foreign key,
/// mirroring `AuditRecord`: `resourceType` is polymorphic across every
/// future producer module, so a single non-polymorphic FK cannot express it,
/// and the envelope must stay inspectable even if the referenced actor or
/// resource is later removed.
model OutboxEvent {
  id               String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name             String
  version          Int
  occurredAt       DateTime        @map("occurred_at") @db.Timestamptz(6)
  actorKind        OutboxActorKind @map("actor_kind")
  actorUserId      String?         @map("actor_user_id") @db.Uuid
  correlationId    String?         @map("correlation_id")
  resourceType     String          @map("resource_type")
  resourceId       String?         @map("resource_id") @db.Uuid
  workspaceContext String?         @map("workspace_context") @db.Uuid
  payload          Json            @default("{}") @db.JsonB
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  deliveries    OutboxDelivery[]
  notifications Notification[]

  @@index([name, occurredAt])
  @@index([resourceType, resourceId])
  @@map("outbox_events")
}

/// One row per durable consumer intended for an `OutboxEvent` (ADR 0001
/// sections 3-4; ADR 0004 section 6). The unique constraint below is the
/// exact idempotency tuple both ADRs require: a crash-and-retry or a poller
/// re-claim can never create a duplicate delivery obligation for the same
/// consumer. `nextAttemptAt` defaults to now - the initial attempt is
/// immediately claimable - and the implementing poller advances it using
/// ADR 0004's fixed backoff schedule (30s, 2m, 10m) on each failure, up to
/// ADR 0001's ceiling of three retries after the initial attempt before
/// marking the row durably `FAILED` for manual replay with the same
/// `eventId`.
model OutboxDelivery {
  id              String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  eventId         String               @map("event_id") @db.Uuid
  consumerName    String               @map("consumer_name")
  consumerVersion Int                  @map("consumer_version")
  status          OutboxDeliveryStatus @default(PENDING)
  attempts        Int                  @default(0)
  nextAttemptAt   DateTime             @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  lastError       String?              @map("last_error")
  succeededAt     DateTime?            @map("succeeded_at") @db.Timestamptz(6)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  event OutboxEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // The poller's claim query (ADR 0004 section 6): pending, due rows in
  // (createdAt, id) order under `FOR UPDATE SKIP LOCKED`.
  @@unique([eventId, consumerName, consumerVersion])
  @@index([status, nextAttemptAt, createdAt])
  @@map("outbox_deliveries")
}

/// A database-backed claim marking one scheduled-occurrence rule as already
/// fired for one source record at one exact UTC instant (ADR 0003 section 3:
/// "database-backed claims... rather than process-local timers or arbitrary
/// sleeps"). The unique constraint is the concurrency and idempotency
/// boundary: a claim-insert conflict means another scanner tick (or a
/// concurrent scanner instance) already recorded this exact occurrence, so
/// firing again would duplicate it. A source record whose scheduled instant
/// changes (e.g. a task's due date moves) gets a new, distinct claim once
/// its new instant is reached, since `scheduledFor` is part of the
/// uniqueness key - matching the ADR's reschedule-safety requirement.
model ScheduledOccurrenceClaim {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  ruleName     String   @map("rule_name")
  ruleVersion  Int      @map("rule_version")
  resourceId   String   @map("resource_id") @db.Uuid
  scheduledFor DateTime @map("scheduled_for") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([ruleName, ruleVersion, resourceId, scheduledFor])
  @@map("scheduled_occurrence_claims")
}

/// The durable, per-recipient notification record (ADR 0003 section 1) - the
/// system of record a client's REST feed reads and reconciles against; a
/// real-time frame is only ever an advisory nudge to refetch it. `taskId`,
/// `messageId`, `eventId`, `meetingId`, and `expenseId` are the typed target
/// union ADR 0003 requires ("not an unchecked entityType/entityId
/// reference... must resolve through an approved module relation") - real
/// foreign keys, not a polymorphic pair, for the five target domains that
/// exist today. A CHECK constraint
/// (added by hand; see the migration) keeps at most one set. A
/// Meeting notifications use the concrete meeting target. To-Do and report
/// reminders carry no target until those domains provide an approved concrete
/// relation and widen the CHECK.
model Notification {
  id              String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  recipientUserId String           @map("recipient_user_id") @db.Uuid
  type            NotificationType
  sourceEventId   String           @map("source_event_id") @db.Uuid
  /// Producer-defined deduplication key (ADR 0003 section 3): an immediate
  /// producer's key includes the source event id; a scheduled producer's key
  /// includes the source record id, the exact scheduled UTC instant, and a
  /// rule/version identifier. This column stores the already-computed key;
  /// it does not interpret its shape.
  occurrenceKey   String           @map("occurrence_key")
  title           String
  body            String
  taskId          String?          @map("task_id") @db.Uuid
  messageId       String?          @map("message_id") @db.Uuid
  eventId         String?          @map("event_id") @db.Uuid
  meetingId       String?          @map("meeting_id") @db.Uuid
  /// EOM-01: the fifth typed target, added for EXPENSE_SUBMITTED/REVIEWED.
  expenseId       String?          @map("expense_id") @db.Uuid
  /// The sixth typed target, added for REPORT_SUBMITTED/REVIEWED.
  reportId        String?          @map("report_id") @db.Uuid
  /// The seventh typed target, added for PARTNER_FOLLOW_UP_DUE.
  partnerId       String?          @map("partner_id") @db.Uuid
  /// The eighth typed target, added for LETTER_SHARED.
  letterId        String?          @map("letter_id") @db.Uuid
  /// The ninth typed target, added for DOCUMENT_SHARED.
  documentId      String?          @map("document_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  readAt          DateTime?        @map("read_at") @db.Timestamptz(6)
  /// Retain the occurrence key so redelivery cannot recreate a removed notification.
  dismissedAt     DateTime?        @map("dismissed_at") @db.Timestamptz(6)

  recipient   User        @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  sourceEvent OutboxEvent @relation(fields: [sourceEventId], references: [id], onDelete: Restrict)
  task        Task?       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  message     Message?    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  event       Event?      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  meeting     Meeting?    @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  expense     Expense?    @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  report      Report?     @relation(fields: [reportId], references: [id], onDelete: Cascade)
  partner     Partner?    @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  letter      Letter?     @relation(fields: [letterId], references: [id], onDelete: Cascade)
  document    Document?   @relation(fields: [documentId], references: [id], onDelete: Cascade)

  // The cursor feed reads a recipient's own notifications newest first
  // (ADR 0003 section 5); the second index supports the unread count.
  @@unique([recipientUserId, type, occurrenceKey])
  @@index([recipientUserId, createdAt, id])
  @@index([recipientUserId, readAt])
  @@map("notifications")
}

/// A per-user, per-type mute override (ADR 0003 section 4): every user
/// starts enabled for every type, so a row's mere existence, not a boolean
/// column, means "muted." Only seven of the twelve `NotificationType` values
/// may ever be muted - assignment, review-outcome, mention, and
/// meeting-invitation notifications represent a direct action, outcome, or
/// participation obligation and cannot be silenced. A CHECK constraint
/// (added by hand; see the migration) enforces that restriction at the
/// database, not just in application code.
model NotificationPreference {
  userId  String           @map("user_id") @db.Uuid
  type    NotificationType
  mutedAt DateTime         @default(now()) @map("muted_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, type])
  @@map("notification_preferences")
}

/// The three SRS reporting periods. Period boundaries are calendar dates;
/// submission and review instants are UTC timestamptz values.
enum ReportType {
  DAILY
  WEEKLY
  MONTHLY
  /// A post-event report (EOM-01): outcomes, budget performance, completed/
  /// incomplete work, challenges, lessons learned, and recommendations for one
  /// event. Linked to that event's workspace via `ReportWorkspace`, the same
  /// checked join every report type already uses - no new relation.
  POST_EVENT

  @@map("report_type")
}

/// Reviewed is the approved terminal state; it is not a separate approval
/// workflow (product vocabulary, Report lifecycle). `UNDER_REVIEW` (EOM-01)
/// is an optional extra step a reviewer may use to mark a submitted report as
/// actively being looked at before deciding; `review()` still accepts either
/// `SUBMITTED` or `UNDER_REVIEW` as its starting state, so no existing report
/// type's flow is forced through it.
enum ReportStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  REVIEWED
  CHANGES_REQUESTED

  @@map("report_status")
}

enum ReportReviewOutcome {
  REVIEWED
  CHANGES_REQUESTED

  @@map("report_review_outcome")
}

/// One author's report for a period. Task/project counts and work progress
/// remain authoritative in their owning modules, not copied into this row.
/// Narrative sections preserve the SRS's type-specific human input; SQL
/// constraints enforce period shape, applicable sections, and review state.
/// Department is the report's explicit organizational context at creation,
/// independent of a later employee transfer. Workspaces use a checked join,
/// never a polymorphic entity-type/id reference.
model Report {
  id                    String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  type                  ReportType
  title                 String
  periodStart           DateTime     @map("period_start") @db.Date
  periodEnd             DateTime     @map("period_end") @db.Date
  authorId              String       @map("author_id") @db.Uuid
  departmentId          String?      @map("department_id") @db.Uuid
  status                ReportStatus @default(DRAFT)
  /// A free-text summary of the report, independent of its type-specific
  /// narrative sections below - the same "plain top-level field" shape as
  /// `title`, applicable to every report type.
  description           String?
  problemsEncountered   String?      @map("problems_encountered")
  nextDayPlan           String?      @map("next_day_plan")
  departmentActivities  String?      @map("department_activities")
  majorAchievements     String?      @map("major_achievements")
  challenges            String?
  nextWeekPlan          String?      @map("next_week_plan")
  departmentPerformance String?      @map("department_performance")
  employeePerformance   String?      @map("employee_performance")
  /// Post-event only (EOM-01); NULL for every other report type.
  lessonsLearned        String?      @map("lessons_learned")
  recommendations       String?
  submittedAt           DateTime?    @map("submitted_at") @db.Timestamptz(6)
  reviewedAt            DateTime?    @map("reviewed_at") @db.Timestamptz(6)
  reviewerId            String?      @map("reviewer_id") @db.Uuid
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  author        User               @relation("ReportAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  department    Department?        @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  reviewer      User?              @relation("ReportCurrentReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  reviews       ReportReview[]
  workspaces    ReportWorkspace[]
  attachments   ReportAttachment[]
  fileIntents   ManagedFile[]      @relation("ManagedFileIntentReport")
  notifications Notification[]

  @@unique([authorId, type, periodStart])
  @@index([authorId, type, periodStart, id])
  @@index([departmentId, type, periodStart, id])
  @@index([status, type, periodStart, id])
  @@index([reviewerId, status])
  @@map("reports")
}

/// A report may discuss several connected workspaces. Both foreign keys are
/// concrete; access to each link is enforced in the reporting application.
model ReportWorkspace {
  reportId    String   @map("report_id") @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  linkedAt    DateTime @default(now()) @map("linked_at") @db.Timestamptz(6)

  report    Report    @relation(fields: [reportId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@id([reportId, workspaceId])
  @@index([workspaceId, reportId])
  @@map("report_workspaces")
}

/// Immutable decision per review cycle; a changes-requested report can later
/// be redrafted and reviewed again without losing the prior decision.
model ReportReview {
  id         String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  reportId   String              @map("report_id") @db.Uuid
  reviewerId String              @map("reviewer_id") @db.Uuid
  outcome    ReportReviewOutcome
  note       String?
  reviewedAt DateTime            @default(now()) @map("reviewed_at") @db.Timestamptz(6)

  report   Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reviewer User   @relation("ReportReviewActor", fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([reportId, reviewedAt, id])
  @@index([reviewerId, reviewedAt])
  @@map("report_reviews")
}

/// Explicit attachment of a managed file to the report that authorizes it -
/// the same concrete, checked join `TaskAttachment`/`ExpenseAttachment`
/// already use, never a polymorphic entity-type/id reference.
model ReportAttachment {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  reportId      String   @map("report_id") @db.Uuid
  managedFileId String   @map("managed_file_id") @db.Uuid
  attachedById  String?  @map("attached_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  report      Report      @relation(fields: [reportId], references: [id], onDelete: Cascade)
  managedFile ManagedFile @relation(fields: [managedFileId], references: [id], onDelete: Restrict)
  attachedBy  User?       @relation("ReportAttachmentActor", fields: [attachedById], references: [id], onDelete: SetNull)

  @@unique([reportId, managedFileId])
  @@index([managedFileId])
  @@index([attachedById])
  @@map("report_attachments")
}

/// Expense cost categories for event spending (EOM-01). `MISCELLANEOUS` is
/// the fallback, matching `EventType.OTHER`'s existing convention.
enum ExpenseCategory {
  VENUE
  CATERING
  TALENT_FEES
  MARKETING_MATERIALS
  LOGISTICS
  EQUIPMENT
  STAFFING
  MISCELLANEOUS

  @@map("expense_category")
}

/// The expense lifecycle (EOM-01). `APPROVED` and `REJECTED` are terminal for
/// a given submission, but a `REJECTED` expense can be edited back to `DRAFT`
/// and resubmitted - the prior decision is never lost, since every decision
/// is also an immutable `ExpenseReview` row. Approval is restricted to
/// whichever role holds `expense.approve` in the permission catalog (Super
/// Admin only, by design - see RBAC-01), not a code-level role check.
enum ExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED

  @@map("expense_status")
}

enum ExpenseReviewOutcome {
  APPROVED
  REJECTED

  @@map("expense_review_outcome")
}

enum SupplierStatus {
  ACTIVE
  INACTIVE

  @@map("supplier_status")
}

/// A supplier/vendor directory entry (EOM-01). `departmentId = NULL` is a
/// shared, organization-wide supplier; a set `departmentId` is private to
/// that department - the same optional-ownership shape `Task` already uses.
model Supplier {
  id           String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name         String
  category     String?
  contactName  String?        @map("contact_name")
  contactEmail String?        @map("contact_email")
  contactPhone String?        @map("contact_phone")
  departmentId String?        @map("department_id") @db.Uuid
  status       SupplierStatus @default(ACTIVE)
  notes        String?
  createdById  String?        @map("created_by_id") @db.Uuid
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdBy  User?       @relation("SupplierCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  expenses   Expense[]

  // A department cannot register the same supplier name twice; NULL
  // department (shared directory) participates in its own uniqueness group.
  @@unique([name, departmentId])
  @@index([departmentId, status])
  @@map("suppliers")
}

/// One expense record against one event (EOM-01). `departmentId` is
/// denormalized from the event at creation time (matching `Report`'s own
/// "department is the record's explicit organizational context at creation"
/// convention) so department-scoped visibility never requires joining
/// through `Event` just to authorize a read.
model Expense {
  id            String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Soft cross-reference to the event this expense belongs to. An expense
  /// must have at least one of `eventId`/`productionId` set (`expenses_has_owner`
  /// CHECK) - the same "at least one explicit owner" shape `Task` already
  /// established for `workspaceId`/`departmentId`.
  eventId       String?         @map("event_id") @db.Uuid
  /// Direct link for an expense recorded against a production that has no
  /// linked event (or one specific to the production itself, independent of
  /// any linked event's own expenses).
  productionId  String?         @map("production_id") @db.Uuid
  /// Optional cross-reference to the campaign this expense's spend counts
  /// against - lets a campaign's actual spend be computed as the sum of its
  /// linked, approved expenses, kept distinct from `Campaign.budgetAmount`
  /// (the plan). Not part of `expenses_has_owner`; an expense still needs an
  /// event or production as its real owner regardless of any campaign link.
  campaignId    String?         @map("campaign_id") @db.Uuid
  departmentId  String          @map("department_id") @db.Uuid
  supplierId    String?         @map("supplier_id") @db.Uuid
  category      ExpenseCategory
  description   String
  /// Optional per-line planned amount, distinct from `Event.budgetAmount`'s
  /// overall total - lets a manager compare one line item's plan to its
  /// actual, not only the whole event's.
  plannedAmount Decimal?        @map("planned_amount") @db.Decimal(14, 2)
  actualAmount  Decimal         @map("actual_amount") @db.Decimal(14, 2)
  currency      String          @db.Char(3)
  status        ExpenseStatus   @default(DRAFT)
  createdById   String?         @map("created_by_id") @db.Uuid
  submittedAt   DateTime?       @map("submitted_at") @db.Timestamptz(6)
  reviewedAt    DateTime?       @map("reviewed_at") @db.Timestamptz(6)
  reviewerId    String?         @map("reviewer_id") @db.Uuid
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  event         Event?              @relation(fields: [eventId], references: [id], onDelete: Restrict)
  production    Production?         @relation(fields: [productionId], references: [id], onDelete: Restrict)
  campaign      Campaign?           @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  department    Department          @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  supplier      Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  createdBy     User?               @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  reviewer      User?               @relation("ExpenseCurrentReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviews       ExpenseReview[]
  attachments   ExpenseAttachment[]
  fileIntents   ManagedFile[]       @relation("ManagedFileIntentExpense")
  notifications Notification[]

  // Planned-vs-actual summaries and approval queues filter by event/
  // department and status; this mirrors Task's own `[owner, status]` shape.
  @@index([eventId, status])
  @@index([productionId, status])
  @@index([campaignId, status])
  @@index([departmentId, status])
  @@index([supplierId])
  @@index([createdById])
  @@map("expenses")
}

/// Immutable decision per review cycle; a rejected expense can later be
/// edited and resubmitted without losing the prior decision - the same
/// "preserve history across cycles" shape as `TaskReview`/`ReportReview`.
model ExpenseReview {
  id         String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  expenseId  String               @map("expense_id") @db.Uuid
  reviewerId String               @map("reviewer_id") @db.Uuid
  outcome    ExpenseReviewOutcome
  note       String?
  reviewedAt DateTime             @default(now()) @map("reviewed_at") @db.Timestamptz(6)

  expense  Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  reviewer User    @relation("ExpenseReviewActor", fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([expenseId, reviewedAt])
  @@index([reviewerId, reviewedAt])
  @@map("expense_reviews")
}

/// A concrete expense parent for an existing managed object (a receipt or
/// invoice), the same shape as `TaskAttachment`/`WorkspaceFileAttachment`.
model ExpenseAttachment {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  expenseId     String   @map("expense_id") @db.Uuid
  managedFileId String   @map("managed_file_id") @db.Uuid
  attachedById  String?  @map("attached_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  expense     Expense     @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  managedFile ManagedFile @relation(fields: [managedFileId], references: [id], onDelete: Restrict)
  attachedBy  User?       @relation("ExpenseAttachmentActor", fields: [attachedById], references: [id], onDelete: SetNull)

  @@unique([expenseId, managedFileId])
  @@index([managedFileId])
  @@index([attachedById])
  @@map("expense_attachments")
}

/// Lifecycle stage of a sponsorship/partnership opportunity.
enum PartnerStatus {
  PROSPECTIVE
  IN_DISCUSSION
  COMMITTED
  DECLINED
  COMPLETED

  @@map("partner_status")
}

/// A sponsor, media organization, brand, or strategic-partner relationship
/// being built or tracked - distinct from `Supplier` (a billed vendor):
/// a Partner is a commercial relationship under development, not someone
/// paid for goods or services. Scoped to a department (e.g. Marketing) the
/// same way every other department-owned resource is.
model Partner {
  id                   String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationName     String        @map("organization_name")
  category             String
  contactName          String?       @map("contact_name")
  contactEmail         String?       @map("contact_email")
  contactPhone         String?       @map("contact_phone")
  departmentId         String?       @map("department_id") @db.Uuid
  /// Soft cross-reference to the campaign or event this opportunity relates
  /// to, where applicable - neither is required; a partnership may exist
  /// before any specific campaign/event is attached.
  campaignId           String?       @map("campaign_id") @db.Uuid
  eventId              String?       @map("event_id") @db.Uuid
  status               PartnerStatus @default(PROSPECTIVE)
  proposedContribution String?       @map("proposed_contribution")
  notes                String?
  followUpAt           DateTime?     @map("follow_up_at") @db.Timestamptz(6)
  /// The user responsible for this relationship (the "opportunity owner").
  ownerId              String?       @map("owner_id") @db.Uuid
  createdById          String?       @map("created_by_id") @db.Uuid
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  department    Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  campaign      Campaign?         @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  event         Event?            @relation(fields: [eventId], references: [id], onDelete: SetNull)
  owner         User?             @relation("PartnerOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy     User?             @relation("PartnerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  activities    PartnerActivity[]
  notifications Notification[]

  @@index([departmentId, status])
  @@index([campaignId])
  @@index([eventId])
  @@index([ownerId])
  @@index([followUpAt])
  @@map("partners")
}

/// Append-only discussion/communication-history entry for one partner
/// relationship - the same append-only shape as `TaskActivity`.
model PartnerActivity {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  partnerId String   @map("partner_id") @db.Uuid
  authorId  String?  @map("author_id") @db.Uuid
  note      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  author  User?   @relation("PartnerActivityAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([partnerId, createdAt])
  @@map("partner_activities")
}

/// Working arrangement for an employee profile.
enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN

  @@map("employment_type")
}

/// Lifecycle status of an employee profile. Distinct from `User.status`
/// (login/account access): an `INACTIVE` employee is deactivated the same
/// way `UsersService.deactivate` deactivates any user (login blocked), but
/// `ON_LEAVE` is purely an HR record state and never touches login access.
enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE

  @@map("employment_status")
}

/// Self-reported sex recorded on an employee profile (HR personal
/// information only - never used for authorization).
enum EmployeeGender {
  MALE
  FEMALE
  OTHER

  @@map("employee_gender")
}

/// HR-only data for an existing `User` account (EMP-01). One-to-one with
/// `User` - an employee is never a separate account, only a linked profile
/// of HR fields on top of one. Department, role, and login/account status
/// all stay the User/Department/RBAC models' own responsibility; this model
/// never duplicates them. Compensation fields are nullable and read-gated
/// in the service layer to the Super Admin and the HR & Executive Officer
/// department manager only - never exposed to a general profile view.
model EmployeeProfile {
  id                 String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId             String           @unique @map("user_id") @db.Uuid
  employeeCode       String           @unique @map("employee_code")
  position           String
  employmentType     EmploymentType   @map("employment_type")
  employmentDate     DateTime         @map("employment_date") @db.Date
  employmentStatus   EmploymentStatus @default(ACTIVE) @map("employment_status")
  workLocation       String?          @map("work_location")
  reportingManagerId String?          @map("reporting_manager_id") @db.Uuid
  grade              String?
  /// Compensation: amount fields pair with `currency` (all-or-nothing,
  /// mirroring `campaigns_budget_amount_and_currency`'s convention). Total
  /// compensation is derived at read time (`baseSalary + allowanceAmount`),
  /// never stored, so it can never drift from its parts.
  baseSalary         Decimal?         @map("base_salary") @db.Decimal(14, 2)
  salaryScale        String?          @map("salary_scale")
  allowanceAmount    Decimal?         @map("allowance_amount") @db.Decimal(14, 2)
  currency           String?          @db.Char(3)
  description        String?
  gender             EmployeeGender?
  dateOfBirth        DateTime?        @map("date_of_birth") @db.Date
  city               String?
  subCity            String?          @map("sub_city")
  woreda             String?
  /// Payroll bank account number. Free text (no bank-identity/IBAN
  /// structure is required yet) - read-gated the same way compensation is,
  /// by the module's own authorization boundary, not a separate check.
  bankAccountNumber  String?          @map("bank_account_number")
  /// A company-issued phone number, distinct from the linked `User.phone`
  /// (the employee's own personal number). Lives here, not on `User`,
  /// because it is tied to the job, not the person - it does not follow the
  /// employee if they leave or change roles.
  companyPhone       String?          @map("company_phone")
  /// Set whenever `employmentStatus` changes, by whom - required so a
  /// status change always carries an attributable actor (EMP-01 §6).
  statusChangedAt    DateTime?        @map("status_changed_at") @db.Timestamptz(6)
  statusChangedById  String?          @map("status_changed_by_id") @db.Uuid
  createdById        String?          @map("created_by_id") @db.Uuid
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user             User  @relation("EmployeeProfileUser", fields: [userId], references: [id], onDelete: Cascade)
  reportingManager User? @relation("EmployeeReportingManager", fields: [reportingManagerId], references: [id], onDelete: SetNull)
  statusChangedBy  User? @relation("EmployeeStatusChangedBy", fields: [statusChangedById], references: [id], onDelete: SetNull)
  createdBy        User? @relation("EmployeeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  // The employee list filters/sorts by status and looks up a manager's reports.
  @@index([employmentStatus])
  @@index([reportingManagerId])
  @@map("employee_profiles")
}

/// Incoming (received) versus outgoing (sent) correspondence. Independent of
/// `LetterCategory` - the reference-number sequence resets per category and
/// year, never per direction.
enum LetterDirection {
  INCOMING
  OUTGOING

  @@map("letter_direction")
}

/// Letter classification driving the reference-number sequence
/// (`LELA-{category}-{year}-{sequence}`). A small, explicit enum - easy to
/// extend with a migration, same convention as `DocumentType` below.
enum LetterCategory {
  CAST
  PROD
  MKT
  PROMO
  EOM
  HR
  OTHER

  @@map("letter_category")
}

/// A centralized, easy-to-extend classification for Document records.
/// `LETTER` marks a document auto-created from a letter attachment.
enum DocumentType {
  LETTER
  REPORT
  PRICE_QUOTATION
  CONTRACT
  INVOICE
  OTHER

  @@map("document_type")
}

/// What a share grants: read-only viewing, or viewing plus download. Both
/// preview and download endpoints enforce this scope.
enum ShareScope {
  VIEW
  VIEW_AND_DOWNLOAD

  @@map("share_scope")
}

/// Administration correspondence (EMP-02 / Letters and Documents). Only
/// Super Admin and the HR & Executive Officer department's own manager may
/// manage letters - enforced in `LettersService`, the same bespoke
/// service-layer boundary Employee Management uses
/// (`isHrExecutiveOfficerManager`), never a new role or RBAC catalog branch.
/// `referenceNumber` is server-generated and immutable; clients can never
/// supply or change it.
model Letter {
  id                    String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  referenceNumber       String          @unique @map("reference_number")
  direction             LetterDirection
  category              LetterCategory
  date                  DateTime        @db.Date
  projectId             String?         @map("project_id") @db.Uuid
  subject               String
  /// Set only for INCOMING letters; a CHECK enforces the pairing with
  /// `direction` and with `toParty`.
  fromParty             String?         @map("from_party")
  /// Set only for OUTGOING letters; a CHECK enforces the pairing with
  /// `direction` and with `fromParty`.
  toParty               String?         @map("to_party")
  /// The reference number printed on a received letter - distinct from
  /// Lela's own generated `referenceNumber`. Incoming only.
  senderReferenceNumber String?         @map("sender_reference_number")
  shortDescription      String?         @map("short_description")
  /// A single quick note captured on the letter itself - distinct from the
  /// chronological `LetterRemark` thread below.
  remark                String?
  createdById           String?         @map("created_by_id") @db.Uuid
  updatedById           String?         @map("updated_by_id") @db.Uuid
  /// Excluded from every ordinary list/detail/download/shared-record query
  /// the moment it is set - never only hidden from the management UI.
  deletedAt             DateTime?       @map("deleted_at") @db.Timestamptz(6)
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  project            Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy          User?              @relation("LetterCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy          User?              @relation("LetterUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  attachments        LetterAttachment[]
  remarks            LetterRemark[]
  shares             Share[]
  documents          Document[]         @relation("DocumentSourceLetter")
  managedFileIntents ManagedFile[]      @relation("ManagedFileIntentLetter")
  notifications      Notification[]

  @@index([direction, date])
  @@index([category])
  @@index([projectId])
  @@index([deletedAt])
  @@map("letters")
}

/// The atomic sequence backing `Letter.referenceNumber`. One row per
/// `(category, year)`; incremented with a single `INSERT ... ON CONFLICT
/// DO UPDATE ... RETURNING` statement, never a read-then-write in
/// application code, so concurrent creates cannot collide.
model LetterReferenceCounter {
  id           String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  category     LetterCategory
  year         Int
  lastSequence Int            @default(0) @map("last_sequence")
  updatedAt    DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([category, year])
  @@map("letter_reference_counters")
}

/// A letter's attachment, the same concrete join shape as `TaskAttachment`/
/// `ReportAttachment` - never a polymorphic entity-type/id reference. Every
/// letter attachment also gets a `Document` row pointing at the same
/// `managedFileId`, created in the same finalize transaction (see `Document`
/// below) - the physical file is never duplicated.
model LetterAttachment {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  letterId      String   @map("letter_id") @db.Uuid
  managedFileId String   @map("managed_file_id") @db.Uuid
  attachedById  String?  @map("attached_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  letter      Letter      @relation(fields: [letterId], references: [id], onDelete: Cascade)
  managedFile ManagedFile @relation(fields: [managedFileId], references: [id], onDelete: Restrict)
  attachedBy  User?       @relation("LetterAttachmentActor", fields: [attachedById], references: [id], onDelete: SetNull)

  @@unique([letterId, managedFileId])
  @@index([managedFileId])
  @@index([attachedById])
  @@map("letter_attachments")
}

/// Append-only remarks thread on a letter - chronological, no edit/delete
/// path, the same shape as `TaskComment`/`PartnerActivity`. Reading and
/// adding a remark requires full letter-management authorization; a shared
/// recipient never sees this thread.
model LetterRemark {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  letterId  String   @map("letter_id") @db.Uuid
  authorId  String?  @map("author_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  letter Letter @relation(fields: [letterId], references: [id], onDelete: Cascade)
  author User?  @relation("LetterRemarkAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([letterId, createdAt])
  @@map("letter_remarks")
}

/// HR-managed document metadata (EMP-02). `managedFileId` is nullable: a
/// document row is created first with no file (mirrors every other
/// attachment flow's "parent exists, then its file is attached" shape -
/// `intentDocumentId` on `ManagedFile` authorizes the upload against this
/// now-existing row), then an upload-intent/finalize cycle attaches the
/// file. `sourceLetterId` is set only for a document auto-created from a
/// letter attachment; soft-deleting that letter does NOT cascade to this
/// row - the document keeps its own independent lifecycle and sharing, and
/// the "from letter" link re-checks letter authorization independently
/// rather than trusting this reference.
model Document {
  id             String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// User-editable display name (Rename). Distinct from the immutable
  /// `ManagedFile.originalFilename`, which always records what was
  /// literally uploaded.
  displayName    String       @map("display_name")
  documentType   DocumentType @map("document_type")
  managedFileId  String?      @unique @map("managed_file_id") @db.Uuid
  projectId      String?      @map("project_id") @db.Uuid
  sourceLetterId String?      @map("source_letter_id") @db.Uuid
  description    String?
  uploadedById   String?      @map("uploaded_by_id") @db.Uuid
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  managedFile        ManagedFile?   @relation("DocumentFile", fields: [managedFileId], references: [id], onDelete: Restrict)
  project            Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  sourceLetter       Letter?        @relation("DocumentSourceLetter", fields: [sourceLetterId], references: [id], onDelete: SetNull)
  uploadedBy         User?          @relation("DocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  shares             Share[]
  managedFileIntents ManagedFile[]  @relation("ManagedFileIntentDocument")
  notifications      Notification[]

  @@index([documentType])
  @@index([projectId])
  @@index([sourceLetterId])
  @@index([uploadedById])
  @@index([deletedAt])
  @@map("documents")
}

/// A grant of access to one letter or document, to one employee or to every
/// active employee - never a per-employee row for "all employees" (that
/// audience is evaluated dynamically at read time, so a newly hired
/// employee gains access immediately with no backfill). CHECKs (added in
/// hand-authored migration SQL - Prisma's schema DSL cannot express them)
/// enforce exactly one target (`letterId` xor `documentId`) and exactly one
/// audience (`recipientId` xor `allEmployees`); partial unique indexes (also
/// hand-authored) prevent a second *active* share for the same target and
/// audience while still allowing a new share after the old one is revoked.
/// Revocation is soft (`revokedAt`/`revokedById`) so history is preserved.
model Share {
  id           String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  letterId     String?    @map("letter_id") @db.Uuid
  documentId   String?    @map("document_id") @db.Uuid
  recipientId  String?    @map("recipient_id") @db.Uuid
  allEmployees Boolean    @default(false) @map("all_employees")
  scope        ShareScope @default(VIEW)
  sharedById   String?    @map("shared_by_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt    DateTime?  @map("revoked_at") @db.Timestamptz(6)
  revokedById  String?    @map("revoked_by_id") @db.Uuid

  letter    Letter?   @relation(fields: [letterId], references: [id], onDelete: Cascade)
  document  Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  recipient User?     @relation("ShareRecipient", fields: [recipientId], references: [id], onDelete: Restrict)
  sharedBy  User?     @relation("ShareSharedBy", fields: [sharedById], references: [id], onDelete: SetNull)
  revokedBy User?     @relation("ShareRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)

  @@index([letterId])
  @@index([documentId])
  @@index([recipientId])
  @@map("shares")
}

// ============================================================
// Attendance Management (ATT-01)
// ============================================================

enum AttendanceMethod {
  OFFICE_KIOSK
  MOBILE_EVENT

  @@map("attendance_method")
}

enum PunchType {
  CHECK_IN
  CHECK_OUT

  @@map("punch_type")
}

enum AttendanceSessionStatus {
  OPEN
  CLOSED
  MISSING_CHECKOUT

  @@map("attendance_session_status")
}

/// `NOT_APPLICABLE` is the office-kiosk default (no geofence applies).
enum AttendanceVerificationResult {
  NOT_APPLICABLE
  VERIFIED
  OUT_OF_RANGE
  LOW_ACCURACY
  LOCATION_UNAVAILABLE
  EXCEPTION_APPROVED

  @@map("attendance_verification_result")
}

enum EventShiftStatus {
  PLANNED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@map("event_shift_status")
}

enum EventShiftChangeType {
  RESCHEDULE
  EXTENSION
  LOCATION_CHANGE
  CANCELLATION
  REINSTATEMENT
  OTHER

  @@map("event_shift_change_type")
}

enum AttendanceOvertimeStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("attendance_overtime_status")
}

enum AttendanceExceptionType {
  MISSED_CHECKOUT
  OUT_OF_RANGE
  LOCATION_UNAVAILABLE
  MANUAL_CORRECTION_REQUEST
  OTHER

  @@map("attendance_exception_type")
}

enum AttendanceExceptionStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("attendance_exception_status")
}

enum AttendanceDayType {
  FULL
  HALF
  OFF

  @@map("attendance_day_type")
}

/// A registered physical kiosk device (office entrance tablet/computer).
/// The kiosk authenticates itself with a long-lived, server-issued bearer
/// secret, hashed at rest with the same Argon2id hasher as user passwords -
/// a client-supplied device id alone is never trusted as proof of origin.
model AttendanceKiosk {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name          String
  locationLabel String    @map("location_label")
  tokenHash     String    @unique @map("token_hash")
  isActive      Boolean   @default(true) @map("is_active")
  createdById   String?   @map("created_by_id") @db.Uuid
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedById   String?   @map("revoked_by_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdBy User?               @relation("AttendanceKioskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  revokedBy User?               @relation("AttendanceKioskRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)
  punches   AttendancePunch[]
  sessions  AttendanceSession[]

  @@index([isActive])
  @@map("attendance_kiosks")
}

/// A scheduled work period against an event/production assignment. Explicit
/// start/end datetimes (never a single calendar date) so an overnight shift
/// is one row, not two. The geofence center and radius live here, not on
/// `Event`, since attendance location policy is this module's own concern.
model EventShift {
  id                   String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  eventId              String           @map("event_id") @db.Uuid
  label                String?
  plannedStartAt       DateTime         @map("planned_start_at") @db.Timestamptz(6)
  plannedEndAt         DateTime         @map("planned_end_at") @db.Timestamptz(6)
  timeZone             String           @map("time_zone")
  locationLabel        String?          @map("location_label")
  latitude             Decimal          @db.Decimal(9, 6)
  longitude            Decimal          @db.Decimal(9, 6)
  geofenceRadiusMeters Int              @default(150) @map("geofence_radius_meters")
  breakMinutes         Int              @default(0) @map("break_minutes")
  status               EventShiftStatus @default(PLANNED)
  createdById          String?          @map("created_by_id") @db.Uuid
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  event       Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdBy   User?                  @relation("EventShiftCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  assignments EventShiftAssignment[]
  changes     EventShiftChange[]
  punches     AttendancePunch[]
  sessions    AttendanceSession[]

  @@index([eventId])
  @@index([plannedStartAt])
  @@index([status])
  @@map("event_shifts")
}

/// Which employees are assigned to a shift - the eligibility boundary for
/// the mobile event-attendance workflow (only an assigned employee, or an
/// explicitly authorized exception, may punch against this shift).
model EventShiftAssignment {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  eventShiftId   String    @map("event_shift_id") @db.Uuid
  employeeId     String    @map("employee_id") @db.Uuid
  assignedById   String?   @map("assigned_by_id") @db.Uuid
  assignedAt     DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(6)
  unassignedAt   DateTime? @map("unassigned_at") @db.Timestamptz(6)
  unassignedById String?   @map("unassigned_by_id") @db.Uuid

  eventShift   EventShift @relation(fields: [eventShiftId], references: [id], onDelete: Cascade)
  employee     User       @relation("EventShiftAssignee", fields: [employeeId], references: [id], onDelete: Cascade)
  assignedBy   User?      @relation("EventShiftAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  unassignedBy User?      @relation("EventShiftUnassignedBy", fields: [unassignedById], references: [id], onDelete: SetNull)

  @@unique([eventShiftId, employeeId])
  @@index([employeeId])
  @@map("event_shift_assignments")
}

/// Append-only schedule-change history for a shift - every reschedule,
/// extension, or cancellation is recorded with its reason rather than
/// overwriting the prior planned times in place.
model EventShiftChange {
  id              String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  eventShiftId    String               @map("event_shift_id") @db.Uuid
  changeType      EventShiftChangeType @map("change_type")
  previousStartAt DateTime?            @map("previous_start_at") @db.Timestamptz(6)
  previousEndAt   DateTime?            @map("previous_end_at") @db.Timestamptz(6)
  newStartAt      DateTime?            @map("new_start_at") @db.Timestamptz(6)
  newEndAt        DateTime?            @map("new_end_at") @db.Timestamptz(6)
  reason          String
  changedById     String?              @map("changed_by_id") @db.Uuid
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  eventShift EventShift @relation(fields: [eventShiftId], references: [id], onDelete: Cascade)
  changedBy  User?      @relation("EventShiftChangeActor", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([eventShiftId, createdAt])
  @@map("event_shift_changes")
}

/// One raw, immutable punch attempt - append-only. `clientRequestId` is the
/// idempotency key: a retried request with the same key resolves to the
/// same row rather than creating a duplicate. Location fields are set only
/// for `MOBILE_EVENT`.
model AttendancePunch {
  id                 String                       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  employeeId         String                       @map("employee_id") @db.Uuid
  method             AttendanceMethod
  punchType          PunchType                    @map("punch_type")
  kioskId            String?                      @map("kiosk_id") @db.Uuid
  eventShiftId       String?                      @map("event_shift_id") @db.Uuid
  clientRequestId    String                       @map("client_request_id")
  recordedAt         DateTime                     @default(now()) @map("recorded_at") @db.Timestamptz(6)
  latitude           Decimal?                     @db.Decimal(9, 6)
  longitude          Decimal?                     @db.Decimal(9, 6)
  accuracyMeters     Decimal?                     @map("accuracy_meters") @db.Decimal(8, 2)
  distanceMeters     Decimal?                     @map("distance_meters") @db.Decimal(10, 2)
  verificationResult AttendanceVerificationResult @default(NOT_APPLICABLE) @map("verification_result")
  createdAt          DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)

  employee   User               @relation("AttendancePunchEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  kiosk      AttendanceKiosk?   @relation(fields: [kioskId], references: [id], onDelete: SetNull)
  eventShift EventShift?        @relation(fields: [eventShiftId], references: [id], onDelete: SetNull)
  checkInOf  AttendanceSession? @relation("SessionCheckIn")
  checkOutOf AttendanceSession? @relation("SessionCheckOut")

  @@unique([employeeId, punchType, clientRequestId])
  @@index([employeeId, recordedAt])
  @@index([kioskId])
  @@index([eventShiftId])
  @@map("attendance_punches")
}

/// The paired check-in/check-out record dashboards and reports query.
/// `actualMinutes`/`netMinutes`/`potentialOvertimeMinutes` are server-
/// computed snapshots, recomputed whenever the session's punches change -
/// never trusted from the client. A partial unique index keeps at most one
/// `OPEN` session per employee at a time (hand-authored migration SQL),
/// which is what actually prevents a duplicate check-in or a check-out with
/// no matching check-in.
model AttendanceSession {
  id                       String                  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  employeeId               String                  @map("employee_id") @db.Uuid
  method                   AttendanceMethod
  kioskId                  String?                 @map("kiosk_id") @db.Uuid
  eventShiftId             String?                 @map("event_shift_id") @db.Uuid
  sessionDate              DateTime                @map("session_date") @db.Date
  checkInPunchId           String                  @unique @map("check_in_punch_id") @db.Uuid
  checkOutPunchId          String?                 @unique @map("check_out_punch_id") @db.Uuid
  status                   AttendanceSessionStatus @default(OPEN)
  scheduledMinutes         Int?                    @map("scheduled_minutes")
  actualMinutes            Int?                    @map("actual_minutes")
  breakMinutes             Int                     @default(0) @map("break_minutes")
  netMinutes               Int?                    @map("net_minutes")
  lateMinutes              Int                     @default(0) @map("late_minutes")
  earlyDepartureMinutes    Int                     @default(0) @map("early_departure_minutes")
  potentialOvertimeMinutes Int                     @default(0) @map("potential_overtime_minutes")
  createdAt                DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee      User                        @relation("AttendanceSessionEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  kiosk         AttendanceKiosk?            @relation(fields: [kioskId], references: [id], onDelete: SetNull)
  eventShift    EventShift?                 @relation(fields: [eventShiftId], references: [id], onDelete: SetNull)
  checkInPunch  AttendancePunch             @relation("SessionCheckIn", fields: [checkInPunchId], references: [id], onDelete: Restrict)
  checkOutPunch AttendancePunch?            @relation("SessionCheckOut", fields: [checkOutPunchId], references: [id], onDelete: Restrict)
  overtime      AttendanceOvertimeApproval?
  exceptions    AttendanceException[]

  @@index([employeeId, sessionDate])
  @@index([eventShiftId])
  @@index([status])
  @@map("attendance_sessions")
}

/// Overtime review for one session's potential-overtime minutes. One row
/// per session; the decision itself is immutable once made (re-review is a
/// new, explicit workflow step, not an overwrite) and is also written to
/// the existing audit log.
model AttendanceOvertimeApproval {
  id                  String                   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  attendanceSessionId String                   @unique @map("attendance_session_id") @db.Uuid
  potentialMinutes    Int                      @map("potential_minutes")
  requestedReason     String?                  @map("requested_reason")
  status              AttendanceOvertimeStatus @default(PENDING)
  approvedMinutes     Int?                     @map("approved_minutes")
  decisionReason      String?                  @map("decision_reason")
  decidedById         String?                  @map("decided_by_id") @db.Uuid
  decidedAt           DateTime?                @map("decided_at") @db.Timestamptz(6)
  createdAt           DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  session   AttendanceSession @relation(fields: [attendanceSessionId], references: [id], onDelete: Cascade)
  decidedBy User?             @relation("AttendanceOvertimeDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("attendance_overtime_approvals")
}

/// A flagged or raised attendance irregularity - a missed checkout, an
/// out-of-geofence punch, or an employee/manager-raised correction request.
/// Reviewing and deciding this is a separate, auditable step, never a
/// silent edit of the underlying session/punch rows.
model AttendanceException {
  id                  String                    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  attendanceSessionId String?                   @map("attendance_session_id") @db.Uuid
  employeeId          String                    @map("employee_id") @db.Uuid
  type                AttendanceExceptionType
  description         String?
  requestedCheckInAt  DateTime?                 @map("requested_check_in_at") @db.Timestamptz(6)
  requestedCheckOutAt DateTime?                 @map("requested_check_out_at") @db.Timestamptz(6)
  status              AttendanceExceptionStatus @default(PENDING)
  reviewNote          String?                   @map("review_note")
  reviewedById        String?                   @map("reviewed_by_id") @db.Uuid
  reviewedAt          DateTime?                 @map("reviewed_at") @db.Timestamptz(6)
  createdById         String?                   @map("created_by_id") @db.Uuid
  createdAt           DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  session    AttendanceSession? @relation(fields: [attendanceSessionId], references: [id], onDelete: Cascade)
  employee   User               @relation("AttendanceExceptionEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewedBy User?              @relation("AttendanceExceptionReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdBy  User?              @relation("AttendanceExceptionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([employeeId, status])
  @@index([status])
  @@map("attendance_exceptions")
}

/// Effective-dated weekly schedule. Changing a weekday's type INSERTS a new
/// row with a chosen `effectiveFrom` date rather than mutating an existing
/// one - existing rows are never updated or deleted, so a report for any
/// past date always resolves the rule that was actually in effect on that
/// date, even after later schedule changes. Seeded with 7 rows
/// (`effectiveFrom = 1970-01-01`) by this model's own migration.
model AttendanceWeekdaySchedule {
  id            String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  dayOfWeek     Int               @map("day_of_week")
  type          AttendanceDayType
  effectiveFrom DateTime          @map("effective_from") @db.Date
  createdById   String?           @map("created_by_id") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  createdBy User? @relation("AttendanceWeekdayScheduleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([dayOfWeek, effectiveFrom])
  @@index([dayOfWeek, effectiveFrom])
  @@map("attendance_weekday_schedules")
}

/// A one-off non-working date, org-wide (not per-department). Each holiday
/// is a factual correction ("this date was/is a declared holiday"), not a
/// policy that changes over time the way the weekly schedule does - so
/// unlike `AttendanceWeekdaySchedule`, holidays are mutated/removed in
/// place, not effective-dated. Overrides the weekly schedule for its date
/// regardless of that weekday's own type.
model AttendanceHoliday {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  date        DateTime @unique @db.Date
  name        String
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdBy User? @relation("AttendanceHolidayCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@map("attendance_holidays")
}

// ============================================================
// Leave Management (ATT-02)
// ============================================================

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
  RETURNED_FOR_CHANGES
  AMENDED

  @@map("leave_request_status")
}

enum LeaveLedgerEntryKind {
  GRANT
  CONSUMPTION
  EXPIRY
  ADJUSTMENT
  REVERSAL

  @@map("leave_ledger_entry_kind")
}

/// An administrator-configured leave type (annual, sick, unpaid, ...).
/// Policy, not code: entitlement/accrual is never hard-coded.
model LeaveType {
  id                    String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name                  String   @unique
  description           String?
  isPaid                Boolean  @default(true) @map("is_paid")
  requiresDocumentation Boolean  @default(false) @map("requires_documentation")
  requiresApproval      Boolean  @default(true) @map("requires_approval")
  isActive              Boolean  @default(true) @map("is_active")
  createdById           String?  @map("created_by_id") @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdBy User?              @relation("LeaveTypeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  grants    LeaveGrant[]
  requests  LeaveRequest[]
  ledger    LeaveLedgerEntry[]

  @@index([isActive])
  @@map("leave_types")
}

/// An immutable grant of leave days to one employee, valid for exactly two
/// years from `grantedAt` (`expiresAt` is set at creation and never
/// changed thereafter). Remaining balance for this grant = `grantedDays`
/// plus the sum of its own ledger entries (consumption/expiry are
/// negative). HR creates these manually - there is no automatic accrual
/// job in this version.
model LeaveGrant {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  employeeId  String   @map("employee_id") @db.Uuid
  leaveTypeId String   @map("leave_type_id") @db.Uuid
  grantedDays Int      @map("granted_days")
  grantedAt   DateTime @map("granted_at") @db.Timestamptz(6)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(6)
  note        String?
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  employee  User               @relation("LeaveGrantEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType          @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  createdBy User?              @relation("LeaveGrantCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  ledger    LeaveLedgerEntry[]

  @@index([employeeId, leaveTypeId])
  @@index([expiresAt])
  @@map("leave_grants")
}

/// Append-only leave balance ledger - the single source of truth for every
/// employee's remaining balance per leave type. A grant's own row never
/// changes; every consumption, expiry, adjustment, or reversal is its own
/// entry, so the full history is always reconstructable. Consumption walks
/// an employee's non-expired grants oldest-first (FIFO) so each grant's own
/// two-year clock is respected independently.
model LeaveLedgerEntry {
  id             String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  employeeId     String               @map("employee_id") @db.Uuid
  leaveTypeId    String               @map("leave_type_id") @db.Uuid
  grantId        String?              @map("grant_id") @db.Uuid
  kind           LeaveLedgerEntryKind
  amountDays     Int                  @map("amount_days")
  leaveRequestId String?              @map("leave_request_id") @db.Uuid
  note           String?
  createdById    String?              @map("created_by_id") @db.Uuid
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  employee     User          @relation("LeaveLedgerEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType    LeaveType     @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  grant        LeaveGrant?   @relation(fields: [grantId], references: [id], onDelete: Cascade)
  leaveRequest LeaveRequest? @relation("LeaveLedgerRequest", fields: [leaveRequestId], references: [id], onDelete: SetNull)
  createdBy    User?         @relation("LeaveLedgerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([employeeId, leaveTypeId])
  @@index([grantId])
  @@index([leaveRequestId])
  @@map("leave_ledger_entries")
}

/// An employee's leave request, full-day only for v1 (`startDate`/`endDate`
/// are dates, inclusive). `amendsRequestId` links an amendment to the
/// approved request it proposes to change - the original is preserved
/// (marked `AMENDED`, not deleted or edited in place) rather than silently
/// changed.
model LeaveRequest {
  id                              String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  employeeId                      String             @map("employee_id") @db.Uuid
  leaveTypeId                     String             @map("leave_type_id") @db.Uuid
  startDate                       DateTime           @map("start_date") @db.Date
  endDate                         DateTime           @map("end_date") @db.Date
  daysRequested                   Int                @map("days_requested")
  reason                          String?
  supportingDocumentManagedFileId String?            @unique @map("supporting_document_managed_file_id") @db.Uuid
  status                          LeaveRequestStatus @default(PENDING)
  amendsRequestId                 String?            @unique @map("amends_request_id") @db.Uuid
  reviewedById                    String?            @map("reviewed_by_id") @db.Uuid
  reviewedAt                      DateTime?          @map("reviewed_at") @db.Timestamptz(6)
  reviewNote                      String?            @map("review_note")
  createdAt                       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                       DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee           User               @relation("LeaveRequestEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType          LeaveType          @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  supportingDocument ManagedFile?       @relation("LeaveRequestSupportingDocument", fields: [supportingDocumentManagedFileId], references: [id], onDelete: SetNull)
  amendsRequest      LeaveRequest?      @relation("LeaveRequestAmendment", fields: [amendsRequestId], references: [id], onDelete: SetNull)
  amendedBy          LeaveRequest?      @relation("LeaveRequestAmendment")
  reviewedBy         User?              @relation("LeaveRequestReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  ledgerEntries      LeaveLedgerEntry[] @relation("LeaveLedgerRequest")
  managedFileIntents ManagedFile[]      @relation("ManagedFileIntentLeaveRequest")

  @@index([employeeId, status])
  @@index([leaveTypeId])
  @@index([startDate, endDate])
  @@map("leave_requests")
}
