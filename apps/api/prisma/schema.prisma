generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// Account and profile record. IAM created it auth-first (`email`, `status`);
/// USR-01 added the SRS profile fields and the deactivation timestamp as a
/// non-destructive extension. All profile fields are nullable: existing rows
/// predate them and USR-02's create-user API is where a name becomes
/// mandatory. Role assignment is `UserRoleAssignment`, owned by RBAC-02 so
/// policy evaluation works before this issue; team membership is the
/// `TeamMembership` join table added by TEAM-01. DEP-01 adds `department_id` (the
/// optional employee -> department assignment) and the inverse
/// `managedDepartments` for the Department Manager slot. `email` uniqueness is
/// case-sensitive at the database; IAM-02 normalises addresses to lower case
/// on every write and lookup.
enum UserAccountStatus {
  ACTIVE
  INACTIVE

  @@map("user_account_status")
}

/// Why a refresh session stopped being valid. Set together with `revoked_at`.
enum SessionRevocationReason {
  LOGOUT
  ROTATED
  REUSE_DETECTED
  EXPIRED
  ADMIN_REVOKED
  PASSWORD_CHANGED

  @@map("session_revocation_reason")
}

model User {
  id            String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email         String            @unique
  firstName     String?           @map("first_name")
  lastName      String?           @map("last_name")
  phone         String?
  profileImage  String?           @map("profile_image")
  status        UserAccountStatus @default(ACTIVE)
  /// Set when `status` becomes INACTIVE and cleared on reactivation; a CHECK
  /// keeps it exactly in step with `status`.
  deactivatedAt DateTime?         @map("deactivated_at") @db.Timestamptz(6)
  /// The one department this user is an employee of, or NULL when unassigned.
  /// Cleared, not cascaded, if that department row is ever removed (DEP-01);
  /// deactivation keeps the assignment.
  departmentId  String?           @map("department_id") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  credential               UserCredential?
  sessions                 AuthSession[]
  roleAssignment           UserRoleAssignment?
  department               Department?               @relation("DepartmentEmployees", fields: [departmentId], references: [id], onDelete: SetNull)
  managedDepartments       Department[]              @relation("DepartmentManager")
  managedTeams             Team[]                    @relation("TeamManager")
  teamMemberships          TeamMembership[]
  managedWorkspaces        Workspace[]               @relation("WorkspaceManager")
  workspaceParticipations  WorkspaceParticipant[]
  createdEvents            Event[]                   @relation("EventCreatedBy")
  createdProjects          Project[]                 @relation("ProjectCreatedBy")
  initiatedManagedFiles    ManagedFile[]             @relation("ManagedFileInitiator")
  workspaceFileAttachments WorkspaceFileAttachment[] @relation("WorkspaceFileAttachedBy")

  // Administrators list and filter users by status and sort them by name.
  @@index([status])
  @@index([lastName, firstName])
  // Scoped visibility and the department roster both filter users by department.
  @@index([departmentId])
  @@map("users")
}

/// Argon2id password credential. Exactly one per user; deleted with the user.
/// `mustChangePassword` marks a credential an operator set on the user's
/// behalf (USR-02 user creation): the account can authenticate but must
/// rotate the password before doing anything else. First-login delivery and
/// enforcement details remain open in OD-01.
model UserCredential {
  id                 String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId             String    @unique @map("user_id") @db.Uuid
  passwordHash       String    @map("password_hash")
  passwordUpdatedAt  DateTime  @default(now()) @map("password_updated_at") @db.Timestamptz(6)
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  failedAttemptCount Int       @default(0) @map("failed_attempt_count")
  lockedUntil        DateTime? @map("locked_until") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_credentials")
}

/// A rotated, hashed refresh session. The raw refresh token is never stored;
/// `refresh_token_hash` holds its digest. On rotation the previous row is
/// revoked with reason `ROTATED` and linked to its successor through
/// `replaced_by_session_id`; reuse of a rotated token revokes the whole
/// `family_id`.
model AuthSession {
  id                  String                   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId              String                   @map("user_id") @db.Uuid
  familyId            String                   @map("family_id") @db.Uuid
  refreshTokenHash    String                   @unique @map("refresh_token_hash")
  issuedAt            DateTime                 @default(now()) @map("issued_at") @db.Timestamptz(6)
  expiresAt           DateTime                 @map("expires_at") @db.Timestamptz(6)
  lastUsedAt          DateTime?                @map("last_used_at") @db.Timestamptz(6)
  rotatedAt           DateTime?                @map("rotated_at") @db.Timestamptz(6)
  revokedAt           DateTime?                @map("revoked_at") @db.Timestamptz(6)
  revokedReason       SessionRevocationReason? @map("revoked_reason")
  replacedBySessionId String?                  @unique @map("replaced_by_session_id") @db.Uuid
  ipAddress           String?                  @map("ip_address") @db.Inet
  userAgent           String?                  @map("user_agent")
  createdAt           DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)

  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy AuthSession? @relation("SessionRotation", fields: [replacedBySessionId], references: [id], onDelete: SetNull)
  replaces   AuthSession? @relation("SessionRotation")

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

/// A qualifier bounding which records a grant covers. `management` is
/// `organization` scope further restricted to organization-wide management
/// data, attached only to Super Admin and Management/Administrator grants.
/// See docs/product/permission-catalog-and-role-matrix.md.
enum PermissionScope {
  ORGANIZATION
  DEPARTMENT
  TEAM
  WORKSPACE
  SELF
  MANAGEMENT

  @@map("permission_scope")
}

/// The fixed enforcement vocabulary: one `resource.action` key per authorized
/// operation, scope-free. `key` is the primary key rather than a surrogate id
/// because the catalog is referenced by this literal string throughout the
/// application, never by an opaque identifier. Rows are seed data (RBAC-01);
/// a new key is added only when a later issue introduces a newly authorized
/// operation. See docs/product/permission-catalog-and-role-matrix.md.
model Permission {
  key         String   @id
  description String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]
  baselineGrants  BaselineGrant[]

  @@map("permissions")
}

/// A configurable role: its access is entirely the set of `RolePermission`
/// grants below, with no inheritance between roles. The five SRS roles are
/// seeded rows, not code branches; `isSystem` marks them so administration
/// can protect them from deletion or rename without ever comparing a role's
/// name in code.
model Role {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]
  userAssignments UserRoleAssignment[]

  @@map("roles")
}

/// A `(role, permission key, scope)` grant. A role's effective permissions
/// are the union of its rows here; absence of a row is denial. The composite
/// primary key is the grant triple itself, so it cannot be represented twice.
model RolePermission {
  roleId        String          @map("role_id") @db.Uuid
  permissionKey String          @map("permission_key")
  scope         PermissionScope
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey, scope])
  @@index([permissionKey])
  @@map("role_permissions")
}

/// A `(permission key, scope)` grant held by every authenticated active user,
/// independent of role and additive to the role matrix. Kept separate from
/// `RolePermission` rather than as a synthetic "Baseline" role, since it is
/// not part of role administration and no user is ever assigned it directly.
/// See "Baseline grants for every authenticated user" in the permission
/// catalog.
model BaselineGrant {
  permissionKey String          @map("permission_key")
  scope         PermissionScope
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([permissionKey, scope])
  @@map("baseline_grants")
}

/// Which single role a user currently holds. Owned by RBAC (RBAC-02), not
/// USR-01: a join table rather than a column on `users`, so it requires no
/// change to that table. This is what lets guards resolve an acting user's
/// grants, and what a role needs to be free of before it can be deleted.
/// USR-01/02 later add the `user.assign_role`-gated endpoint that writes
/// here; until then, rows exist only for accounts an operator has assigned
/// directly.
model UserRoleAssignment {
  userId    String   @id @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@index([roleId])
  @@map("user_role_assignments")
}

/// A stable organizational unit that groups employees and department-owned
/// work (SRS 5.3). DEP-01 models only the unit itself and its two direct
/// relationships to `users`: `manager_id` for the Department Manager and the
/// inverse of `users.department_id` for its employees. Teams carry their own
/// `department_id` added by TEAM-01; "Active Projects/Tasks" are derived
/// summaries a later slice computes, not columns here.
///
/// `name` is unique case-sensitively at the database, matching `users.email`;
/// DEP-02 trims and normalises on write. `deactivated_at` (NULL = active) is
/// the safe-deactivation marker only — departments have no SRS status field
/// and the archive/delete/reassignment policy is OD-02.
model Department {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name          String    @unique
  description   String?
  managerId     String?   @map("manager_id") @db.Uuid
  /// Set when the department is deactivated and cleared on reactivation;
  /// NULL means active.
  deactivatedAt DateTime? @map("deactivated_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  manager   User?  @relation("DepartmentManager", fields: [managerId], references: [id], onDelete: SetNull)
  employees User[] @relation("DepartmentEmployees")
  teams     Team[]

  // Look up the departments a user manages, and list active departments.
  @@index([managerId])
  @@index([deactivatedAt])
  @@map("departments")
}

/// A working group owned by exactly one department (SRS 5.4). TEAM-01 models
/// the unit, its manager slot, and its membership join table; the derived
/// "Active Projects/Events" summaries and the team-to-work assignments
/// (events, projects, campaigns, tasks) belong to later slices and add no
/// column here.
///
/// `department_id` is required: a team is always department-owned, which is
/// what makes `team.read` at `department` scope resolvable. The FK is
/// `ON DELETE RESTRICT` rather than cascading, so the archive / delete /
/// reassignment policy for a department that still owns teams stays open in
/// OD-02 instead of being silently decided here; a later slice widens
/// DEP-02's "in use" check to cover owned teams.
///
/// `name` is unique per department (case-sensitively, matching
/// `departments.name` and `users.email`); TEAM-02 trims and normalises on
/// write. `deactivated_at` (NULL = active) is the safe-deactivation marker
/// only, mirroring `departments`.
model Team {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name          String
  description   String?
  departmentId  String    @map("department_id") @db.Uuid
  managerId     String?   @map("manager_id") @db.Uuid
  /// Set when the team is deactivated and cleared on reactivation;
  /// NULL means active.
  deactivatedAt DateTime? @map("deactivated_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  department Department       @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  manager    User?            @relation("TeamManager", fields: [managerId], references: [id], onDelete: SetNull)
  members    TeamMembership[]
  workspaces WorkspaceTeam[]

  // A department cannot hold two teams of the same name; this index also
  // serves the department-scoped team list.
  @@unique([departmentId, name])
  // Look up the teams a user manages, and list active teams.
  @@index([managerId])
  @@index([deactivatedAt])
  @@map("teams")
}

/// The explicit user-to-team relationship (SRS 5.4 "Team Members"). The
/// composite primary key is the pair itself, so a user cannot be recorded in
/// the same team twice. Both sides cascade: membership is pure join data with
/// no meaning once either the team or the user is gone. Approved
/// responsibility / membership metadata, if a requirement lands, is added by
/// TEAM-02; the lifecycle of a membership is OD-02.
model TeamMembership {
  teamId    String   @map("team_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  // List every team a given user belongs to.
  @@index([userId])
  @@map("team_memberships")
}

/// Which module owns the work behind a workspace root. This is an explicit
/// discriminator, not a polymorphic `entity_type` string: the owning module
/// record (an event, a project, a production project, or a campaign, all
/// delivered by later epics) points back at its `Workspace` with a unique
/// `workspace_id`, and `kind` records which of those four it is. Production
/// and project are kept distinct because Production Management retains
/// ownership of production projects (see product vocabulary) even though both
/// follow the common project lifecycle.
enum WorkspaceKind {
  EVENT
  PROJECT
  PRODUCTION
  CAMPAIGN

  @@map("workspace_kind")
}

/// The organization-owned ownership and authorization anchor for one unit of
/// connected work (SRS 5.5 Event Workspace, 5.7 Production, 5.8 Promotion).
/// WSP-01 models only the root and its shared manager, team, and participant
/// relations; the connected records themselves (tasks, meetings, files,
/// discussions, reports, calendar projections) stay owned by their modules and
/// link back through explicit per-module relations added by later slices, never
/// a generic `related_entity_type` / `related_entity_id` pair.
///
/// The root carries no name, description, or status: those belong to the owning
/// module record, whose lifecycle (Planning / Ready / Completed, Planned /
/// Active / Completed, ...) is not duplicated here. Any archive or deactivate
/// marker for a workspace is deferred with OD-02.
model Workspace {
  id        String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  kind      WorkspaceKind
  /// The user who manages this workspace and, through that assignment, holds
  /// the `workspace`-scoped permission set for it (permission catalog, "Entity
  /// manager assignments"). Cleared, not cascaded, when the user row is
  /// removed; NULL means unassigned.
  managerId String?       @map("manager_id") @db.Uuid
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  manager         User?                     @relation("WorkspaceManager", fields: [managerId], references: [id], onDelete: SetNull)
  teams           WorkspaceTeam[]
  participants    WorkspaceParticipant[]
  fileAttachments WorkspaceFileAttachment[]
  /// The parent authorized when an upload intent is issued. This remains
  /// explicit until finalization creates the attachment, preventing an intent
  /// from being replayed against another workspace.
  fileUploadIntents ManagedFile[] @relation("ManagedFileIntentWorkspace")
  /// The one module record that owns this workspace, when its `kind` is
  /// `EVENT` or `PROJECT`. Later epics add the equivalent inverse for
  /// production and campaign.
  event           Event?
  project         Project?

  // "Workspaces of kind X" and "workspaces a user manages" are the two root
  // access patterns.
  @@index([kind])
  @@index([managerId])
  @@map("workspaces")
}

/// The backend-governed lifecycle of an opaque stored object. `PENDING` is an
/// authorized but unfinalized upload intent, `AVAILABLE` is a verified object
/// with an approved explicit attachment, and `UNAVAILABLE` is an expired,
/// rejected, detached, or missing object awaiting the cleanup lifecycle. This
/// is storage metadata, not a product-workflow status (see ADR 0002).
enum ManagedFileState {
  PENDING
  AVAILABLE
  UNAVAILABLE

  @@map("managed_file_state")
}

/// Authoritative metadata for one private S3-compatible object (ADR 0002).
/// The opaque `storageKey` is unique but never a browser/API contract, and
/// bucket/provider configuration remains in the backend infrastructure
/// adapter. The eventual FIL-02 upload/finalize flow owns state transitions;
/// this data slice only persists the validated intent, verification, and
/// retention information required to make those transitions safe.
model ManagedFile {
  id                String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// API-generated opaque object reference. It contains no filename, actor,
  /// workspace, bucket, provider URL, or presigned URL.
  storageKey        String           @unique @map("storage_key")
  originalFilename  String           @map("original_filename")
  declaredMediaType String           @map("declared_media_type")
  declaredSizeBytes Int              @map("declared_size_bytes")
  verifiedMediaType String?          @map("verified_media_type")
  verifiedSizeBytes Int?             @map("verified_size_bytes")
  state             ManagedFileState @default(PENDING)
  /// PENDING intents expire after 24 hours. The timestamp is retained as
  /// lifecycle evidence after finalization rather than being rewritten.
  intentExpiresAt   DateTime         @map("intent_expires_at") @db.Timestamptz(6)
  uploadedAt        DateTime?        @map("uploaded_at") @db.Timestamptz(6)
  availableAt       DateTime?        @map("available_at") @db.Timestamptz(6)
  unavailableAt     DateTime?        @map("unavailable_at") @db.Timestamptz(6)
  /// The earliest retention-cleanup time. It is populated only when a file is
  /// unavailable; a later lifecycle service applies the 7-day orphan or
  /// 30-day detached-file policy from ADR 0002.
  cleanupAfter      DateTime?        @map("cleanup_after") @db.Timestamptz(6)
  initiatedById     String?          @map("initiated_by_id") @db.Uuid
  /// Nullable only to preserve any pre-FIL-02 pending records during the
  /// migration. FIL-02 creates every new intent with this explicit parent.
  intentWorkspaceId String?          @map("intent_workspace_id") @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  initiatedBy          User?                     @relation("ManagedFileInitiator", fields: [initiatedById], references: [id], onDelete: SetNull)
  intentWorkspace      Workspace?                @relation("ManagedFileIntentWorkspace", fields: [intentWorkspaceId], references: [id], onDelete: Restrict)
  workspaceAttachments WorkspaceFileAttachment[]

  // Upload expiry, cleanup sweeps, actor investigation, and resolving a
  // file's approved parent are the storage access patterns.
  @@index([state, intentExpiresAt])
  @@index([state, cleanupAfter])
  @@index([initiatedById])
  @@index([intentWorkspaceId])
  @@map("managed_files")
}

/// Explicit attachment of a managed file to the connected workspace that
/// authorizes it. This intentionally does not use an unchecked generic
/// `entityType`/`entityId` relation; later parent modules add their own
/// concrete attachment tables rather than widening this association.
model WorkspaceFileAttachment {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId   String   @map("workspace_id") @db.Uuid
  managedFileId String   @map("managed_file_id") @db.Uuid
  attachedById  String?  @map("attached_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Restrict deletion so a later lifecycle service must explicitly detach the
  // association and transition the managed file before either parent is removed.
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  managedFile ManagedFile @relation(fields: [managedFileId], references: [id], onDelete: Restrict)
  attachedBy  User?       @relation("WorkspaceFileAttachedBy", fields: [attachedById], references: [id], onDelete: SetNull)

  // The same file cannot be attached to the same workspace twice; the reverse
  // lookup resolves explicit parent context before an authorized download.
  @@unique([workspaceId, managedFileId])
  @@index([managedFileId])
  @@index([attachedById])
  @@map("workspace_file_attachments")
}

/// A team explicitly assigned to a workspace (SRS 5.4 "Teams can be assigned to
/// events, projects, campaigns, and tasks"). The composite primary key is the
/// pair itself, so a team cannot be assigned to the same workspace twice. Both
/// sides cascade: the assignment is pure join data with no meaning once either
/// the workspace or the team is gone.
model WorkspaceTeam {
  workspaceId String   @map("workspace_id") @db.Uuid
  teamId      String   @map("team_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([workspaceId, teamId])
  // List every workspace a given team is assigned to.
  @@index([teamId])
  @@map("workspace_teams")
}

/// A user who individually participates in a workspace (an assigned employee,
/// distinct from being on an assigned team). The composite primary key is the
/// pair, so a user cannot be recorded in the same workspace twice. Both sides
/// cascade: participation is pure join data. Approved participation metadata
/// (role in the workspace, who assigned it), if a requirement lands, is added
/// by a later slice; the EVE-33 audit catalog already records the actor of an
/// assignment change.
model WorkspaceParticipant {
  workspaceId String   @map("workspace_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  // List every workspace a given user participates in.
  @@index([userId])
  @@map("workspace_participants")
}

/// The kind of event (SRS 5.5 "Event Types"). `OTHER` is the SRS fallback.
/// Whether these baseline types are renameable / deactivatable, and who may
/// supply the value behind an "Other" event, are open in OD-17; modelled as a
/// fixed enum for now (matching `WorkspaceKind`), and a later approved
/// decision that makes types configurable migrates this to a reference table.
enum EventType {
  FILM_PREMIERE
  CONCERT
  ALBUM_RELEASE
  PRODUCT_LAUNCH
  CORPORATE_EVENT
  PROMOTIONAL_EVENT
  OTHER

  @@map("event_type")
}

/// The event lifecycle state (SRS 5.5). `PLANNING` is the initial state;
/// `COMPLETED` and `CANCELLED` are terminal. The approved transition graph is
/// `Planning -> Ready | In Progress | Cancelled`, `Ready -> In Progress |
/// Cancelled`, `In Progress -> Completed | Cancelled`. The entry criteria for
/// `READY`, whether it is mandatory, who may make each move, and whether a
/// terminal event can be reopened are open in OD-05 and enforced by EVT-02 in
/// the domain layer - a CHECK cannot express a state machine.
enum EventStatus {
  PLANNING
  READY
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@map("event_status")
}

/// One managed event (SRS 5.5). The shared operational context - the event
/// manager, the assigned teams, and the assigned employees - lives on the
/// event's connected `Workspace` (WSP-01), not here: `workspace.manager_id` is
/// the Event Manager, `workspace_teams` the assigned teams, and
/// `workspace_participants` the assigned employees. This model carries only the
/// event-specific attributes plus the one-to-one link back to that workspace.
///
/// `workspace_id` is required and unique: every event owns exactly one
/// workspace, created with it and always of `kind = EVENT` (EVT-02 sets that
/// pairing; a plain foreign key cannot cross-check the discriminator). The FK
/// is `ON DELETE RESTRICT` so a workspace an event still owns cannot be
/// dropped out from under it; EVT-02's delete path removes the event and then
/// its workspace in one transaction.
///
/// `organizer_name` and `location` are free text pending OD-16 (whether an
/// organizer or location is a user, a contact, free text, or a structured
/// record). `budget_amount` / `budget_currency` follow the architecture rule
/// "money as numeric with an explicit currency code"; the supported currency
/// set, rounding, and organization default are open in OD-14. The
/// event-to-talent extension (SRS `EventTalent`: role and status per assigned
/// talent) is added once Talent Management provides a `talents` table to
/// reference.
model Event {
  id             String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId    String      @unique @map("workspace_id") @db.Uuid
  name           String
  eventType      EventType   @map("event_type")
  description    String?
  /// UTC start / end of the event. Nullable: a `PLANNING` event may not be
  /// scheduled yet. A CHECK keeps `end_at` at or after `start_at` when both
  /// are set. Display time zones and all-day handling are open in OD-15;
  /// storage stays UTC.
  startAt        DateTime?   @map("start_at") @db.Timestamptz(6)
  endAt          DateTime?   @map("end_at") @db.Timestamptz(6)
  location       String?
  organizerName  String?     @map("organizer_name")
  status         EventStatus @default(PLANNING)
  /// Optional budget. A CHECK requires the amount and the ISO-4217 currency
  /// code to be set together, the amount to be non-negative, and the code to
  /// be three upper-case letters.
  budgetAmount   Decimal?    @map("budget_amount") @db.Decimal(14, 2)
  budgetCurrency String?     @map("budget_currency") @db.Char(3)
  /// The user who created the event; cleared, not cascaded, if that user row
  /// is removed.
  createdById    String?     @map("created_by_id") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  createdBy User?     @relation("EventCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  /// General projects that optionally relate to this event (PRJ-01). A soft,
  /// unbounded cross-reference between peers, not ownership - deleting the
  /// event clears it on each project rather than being blocked.
  projects  Project[]

  // Administration and the connected-workspace overview filter events by
  // lifecycle state, type, schedule, and author.
  @@index([status])
  @@index([eventType])
  @@index([startAt])
  @@index([createdById])
  @@map("events")
}

/// The general-project lifecycle state (SRS 9; product vocabulary "General
/// project"). `PLANNED` is the initial state; `COMPLETED` and `CANCELLED` are
/// terminal. The approved transition graph is `Planned -> Active | Cancelled`,
/// `Active -> Completed | Cancelled` - the same shape as `EventStatus`. Entry
/// criteria for `ACTIVE`/`COMPLETED`, who may make each move, and whether a
/// terminal project can be reopened are open in OD-03 and enforced by PRJ-02
/// in the domain layer - a CHECK cannot express a state machine.
enum ProjectStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED

  @@map("project_status")
}

/// One general project (SRS 9; product vocabulary "Project" / "General
/// project"). Production Management's specialized projects are a distinct
/// model owned by the PRD epic (workspace `kind = PRODUCTION`); this table
/// never carries a type discriminator because its workspace is always
/// `kind = PROJECT`, the same reasoning that keeps `Event` discriminator-free.
///
/// The shared operational context - the project manager, the assigned teams,
/// and the assigned employees - lives on the project's connected `Workspace`
/// (WSP-01), not here: `workspace.manager_id` is the project manager,
/// `workspace_teams` the assigned teams, and `workspace_participants` the
/// assigned employees. This model carries only the project-specific
/// attributes plus the one-to-one link back to that workspace.
///
/// `workspace_id` is required and unique: every project owns exactly one
/// workspace, created with it and always of `kind = PROJECT` (PRJ-02 sets
/// that pairing; a plain foreign key cannot cross-check the discriminator).
/// The FK is `ON DELETE RESTRICT` so a workspace a project still owns cannot
/// be dropped out from under it; PRJ-02's delete path removes the project and
/// then its workspace in one transaction.
///
/// `event_id` is the optional relationship to an event the product vocabulary
/// describes ("Project"): a soft, unbounded cross-reference between peers,
/// `ON DELETE SET NULL` because it is not an ownership relationship. The
/// equally-described optional relationship to a campaign is deferred until
/// Campaign Management (CAM-01) provides a `campaigns` table to reference.
///
/// Progress is deliberately **not** a stored column: OD-03 leaves how it is
/// calculated open, and the issue requires it to be computed from
/// authoritative work (tasks) rather than held as redundant, staleness-prone
/// data. It is added once Task Management provides the source to compute it
/// from. Budget is out of scope for general projects per the PRJ epic's
/// stated scope (unlike events, which do carry one).
model Project {
  id          String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId String        @unique @map("workspace_id") @db.Uuid
  name        String
  description String?
  /// UTC start / end of the project. Nullable: a `PLANNED` project may not be
  /// scheduled yet. A CHECK keeps `end_at` at or after `start_at` when both
  /// are set. Display time zones and all-day handling are open in OD-15;
  /// storage stays UTC.
  startAt     DateTime?     @map("start_at") @db.Timestamptz(6)
  endAt       DateTime?     @map("end_at") @db.Timestamptz(6)
  status      ProjectStatus @default(PLANNED)
  eventId     String?       @map("event_id") @db.Uuid
  /// The user who created the project; cleared, not cascaded, if that user
  /// row is removed.
  createdById String?       @map("created_by_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  event     Event?    @relation(fields: [eventId], references: [id], onDelete: SetNull)
  createdBy User?     @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  // Administration and the connected-workspace overview filter projects by
  // lifecycle state, related event, schedule, and author.
  @@index([status])
  @@index([eventId])
  @@index([startAt])
  @@index([createdById])
  @@map("projects")
}
