{
  "components": {
    "schemas": {
      "AddRolePermissionDto": {
        "properties": {
          "permissionKey": {
            "example": "task.review",
            "type": "string"
          },
          "scope": {
            "enum": [
              "ORGANIZATION",
              "DEPARTMENT",
              "TEAM",
              "WORKSPACE",
              "SELF",
              "MANAGEMENT"
            ],
            "example": "ORGANIZATION",
            "type": "string"
          }
        },
        "required": ["permissionKey", "scope"],
        "type": "object"
      },
      "AuthenticatedUserResponse": {
        "properties": {
          "email": {
            "example": "manager@example.com",
            "format": "email",
            "type": "string"
          },
          "id": {
            "example": "018f2c9e-1d3a-7b21-9c44-2f1a6b5d0e77",
            "format": "uuid",
            "type": "string"
          },
          "status": {
            "enum": ["ACTIVE", "INACTIVE"],
            "example": "ACTIVE",
            "type": "string"
          }
        },
        "required": ["id", "email", "status"],
        "type": "object"
      },
      "CreateRoleDto": {
        "properties": {
          "description": {
            "example": "Coordinates activity across one region.",
            "type": "string"
          },
          "name": {
            "example": "Regional Coordinator",
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": ["name"],
        "type": "object"
      },
      "LivenessResponse": {
        "properties": {
          "status": {
            "enum": ["ok"],
            "example": "ok",
            "type": "string"
          },
          "timestamp": {
            "example": "2026-09-01T09:00:00.000Z",
            "format": "date-time",
            "type": "string"
          }
        },
        "required": ["status", "timestamp"],
        "type": "object"
      },
      "LoginDto": {
        "properties": {
          "email": {
            "example": "manager@example.com",
            "format": "email",
            "type": "string"
          },
          "password": {
            "example": "correct horse battery staple",
            "minLength": 8,
            "type": "string"
          }
        },
        "required": ["email", "password"],
        "type": "object"
      },
      "PermissionResponse": {
        "properties": {
          "description": {
            "example": "Record Approved or Changes Requested while a task is Under Review.",
            "type": "string"
          },
          "key": {
            "example": "task.review",
            "type": "string"
          }
        },
        "required": ["key", "description"],
        "type": "object"
      },
      "ProblemDetails": {
        "properties": {
          "code": {
            "example": "VALIDATION_ERROR",
            "type": "string"
          },
          "detail": {
            "example": "One or more request values are invalid.",
            "type": "string"
          },
          "errors": {
            "description": "Field-level details when the failure is a validation error.",
            "type": "object"
          },
          "instance": {
            "example": "/api/v1/auth/login",
            "type": "string"
          },
          "requestId": {
            "example": "018f2c9e-1d3a-7b21-9c44-2f1a6b5d0e77",
            "type": "string"
          },
          "status": {
            "example": 400,
            "type": "number"
          },
          "title": {
            "example": "Validation Failed",
            "type": "string"
          },
          "type": {
            "example": "https://api.event-platform.local/problems/validation_error",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "code",
          "requestId"
        ],
        "type": "object"
      },
      "ReadinessChecks": {
        "properties": {
          "database": {
            "enum": ["up"],
            "example": "up",
            "type": "string"
          }
        },
        "required": ["database"],
        "type": "object"
      },
      "ReadinessResponse": {
        "properties": {
          "checks": {
            "$ref": "#/components/schemas/ReadinessChecks"
          },
          "status": {
            "enum": ["ready"],
            "example": "ready",
            "type": "string"
          },
          "timestamp": {
            "example": "2026-09-01T09:00:00.000Z",
            "format": "date-time",
            "type": "string"
          }
        },
        "required": ["checks", "status", "timestamp"],
        "type": "object"
      },
      "RoleGrantResponse": {
        "properties": {
          "permissionKey": {
            "example": "task.review",
            "type": "string"
          },
          "scope": {
            "enum": [
              "ORGANIZATION",
              "DEPARTMENT",
              "TEAM",
              "WORKSPACE",
              "SELF",
              "MANAGEMENT"
            ],
            "example": "ORGANIZATION",
            "type": "string"
          }
        },
        "required": ["permissionKey", "scope"],
        "type": "object"
      },
      "RoleResponse": {
        "properties": {
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "description": {
            "example": "Coordinates activity across one region.",
            "nullable": true,
            "type": "string"
          },
          "id": {
            "example": "018f2c9e-1d3a-7b21-9c44-2f1a6b5d0e77",
            "format": "uuid",
            "type": "string"
          },
          "isSystem": {
            "description": "Whether this is one of the five built-in SRS roles.",
            "example": false,
            "type": "boolean"
          },
          "name": {
            "example": "Regional Coordinator",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "isSystem",
          "createdAt",
          "updatedAt"
        ],
        "type": "object"
      },
      "RoleWithGrantsResponse": {
        "properties": {
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "description": {
            "example": "Coordinates activity across one region.",
            "nullable": true,
            "type": "string"
          },
          "grants": {
            "items": {
              "$ref": "#/components/schemas/RoleGrantResponse"
            },
            "type": "array"
          },
          "id": {
            "example": "018f2c9e-1d3a-7b21-9c44-2f1a6b5d0e77",
            "format": "uuid",
            "type": "string"
          },
          "isSystem": {
            "description": "Whether this is one of the five built-in SRS roles.",
            "example": false,
            "type": "boolean"
          },
          "name": {
            "example": "Regional Coordinator",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "isSystem",
          "createdAt",
          "updatedAt",
          "grants"
        ],
        "type": "object"
      },
      "SessionResponse": {
        "properties": {
          "user": {
            "$ref": "#/components/schemas/AuthenticatedUserResponse"
          }
        },
        "required": ["user"],
        "type": "object"
      },
      "UpdateRoleDto": {
        "properties": {
          "description": {
            "example": "Coordinates activity across one region.",
            "type": "string"
          },
          "name": {
            "example": "Regional Coordinator",
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "securitySchemes": {
      "cookie": {
        "description": "Short-lived access token cookie",
        "in": "cookie",
        "name": "access_token",
        "type": "apiKey"
      },
      "csrf-token": {
        "description": "CSRF token for state-changing authenticated requests",
        "in": "header",
        "name": "x-csrf-token",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "contact": {},
    "description": "Versioned API for the Event and Creative Operations Management Platform",
    "title": "Event and Creative Operations Platform API",
    "version": "1.0"
  },
