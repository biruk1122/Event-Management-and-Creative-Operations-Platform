{
  "components": {
    "schemas": {
      "AuthenticatedUserResponse": {
        "properties": {
          "email": {
            "example": "manager@example.com",
            "format": "email",
            "type": "string"
          },
          "id": {
            "example": "018f2c9e-1d3a-7b21-9c44-2f1a6b5d0e77",
            "format": "uuid",
            "type": "string"
          },
          "status": {
            "enum": ["ACTIVE", "INACTIVE"],
            "example": "ACTIVE",
            "type": "string"
          }
        },
        "required": ["id", "email", "status"],
        "type": "object"
      },
      "LivenessResponse": {
        "properties": {
          "status": {
            "enum": ["ok"],
            "example": "ok",
            "type": "string"
          },
          "timestamp": {
            "example": "2026-09-01T09:00:00.000Z",
            "format": "date-time",
            "type": "string"
          }
        },
        "required": ["status", "timestamp"],
        "type": "object"
      },
      "LoginDto": {
        "properties": {
          "email": {
            "example": "manager@example.com",
            "format": "email",
            "type": "string"
          },
          "password": {
            "example": "correct horse battery staple",
            "minLength": 8,
            "type": "string"
          }
        },
        "required": ["email", "password"],
        "type": "object"
      },
      "ProblemDetails": {
        "properties": {
          "code": {
            "example": "VALIDATION_ERROR",
            "type": "string"
          },
          "detail": {
            "example": "One or more request values are invalid.",
            "type": "string"
          },
          "errors": {
            "description": "Field-level details when the failure is a validation error.",
            "type": "object"
          },
          "instance": {
            "example": "/api/v1/auth/login",
            "type": "string"
          },
          "requestId": {
            "example": "018f2c9e-1d3a-7b21-9c44-2f1a6b5d0e77",
            "type": "string"
          },
          "status": {
            "example": 400,
            "type": "number"
          },
          "title": {
            "example": "Validation Failed",
            "type": "string"
          },
          "type": {
            "example": "https://api.event-platform.local/problems/validation_error",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "code",
          "requestId"
        ],
        "type": "object"
      },
      "ReadinessChecks": {
        "properties": {
          "database": {
            "enum": ["up"],
            "example": "up",
            "type": "string"
          }
        },
        "required": ["database"],
        "type": "object"
      },
      "ReadinessResponse": {
        "properties": {
          "checks": {
            "$ref": "#/components/schemas/ReadinessChecks"
          },
          "status": {
            "enum": ["ready"],
            "example": "ready",
            "type": "string"
          },
          "timestamp": {
            "example": "2026-09-01T09:00:00.000Z",
            "format": "date-time",
            "type": "string"
          }
        },
        "required": ["checks", "status", "timestamp"],
        "type": "object"
      },
      "SessionResponse": {
        "properties": {
          "user": {
            "$ref": "#/components/schemas/AuthenticatedUserResponse"
          }
        },
        "required": ["user"],
        "type": "object"
      }
    },
    "securitySchemes": {
      "cookie": {
        "description": "Short-lived access token cookie",
        "in": "cookie",
        "name": "access_token",
        "type": "apiKey"
      },
      "csrf-token": {
        "description": "CSRF token for state-changing authenticated requests",
        "in": "header",
        "name": "x-csrf-token",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "contact": {},
    "description": "Versioned API for the Event and Creative Operations Management Platform",
    "title": "Event and Creative Operations Platform API",
    "version": "1.0"
  },
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "operationId": "Auth_login_v1",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            },
            "description": ""
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Validation failed"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Invalid credentials"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Account inactive or locked"
          }
        },
        "summary": "Exchange email and password for session cookies",
        "tags": ["Authentication"]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "Auth_logout_v1",
        "parameters": [],
        "responses": {
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Validation failed"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "CSRF token invalid"
          }
        },
        "security": [
          {
            "csrf-token": []
          }
        ],
        "summary": "Revoke the current session and clear cookies",
        "tags": ["Authentication"]
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "operationId": "Auth_me_v1",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthenticatedUserResponse"
                }
              }
            },
            "description": ""
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Validation failed"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Not authenticated"
          }
        },
        "security": [
          {
            "access_token": []
          }
        ],
        "summary": "Return the authenticated account",
        "tags": ["Authentication"]
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "operationId": "Auth_refresh_v1",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            },
            "description": ""
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Validation failed"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Missing, expired, revoked, or replayed session"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "CSRF token invalid"
          }
        },
        "security": [
          {
            "csrf-token": []
          }
        ],
        "summary": "Rotate the refresh session and reissue cookies",
        "tags": ["Authentication"]
      }
    },
    "/health/live": {
      "get": {
        "operationId": "Health_getLiveness",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivenessResponse"
                }
              }
            },
            "description": ""
          }
        },
        "summary": "Verify that the API process is running",
        "tags": ["Health"]
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "Health_getReadiness",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": ""
          },
          "503": {
            "description": "PostgreSQL is unavailable"
          }
        },
        "summary": "Verify that PostgreSQL is ready",
        "tags": ["Health"]
      }
    }
  },
  "servers": [],
  "tags": []
}
